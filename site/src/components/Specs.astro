---
//! What a stream can be, in a line: from README.md and docs/parity.md.
const specs = [
  ['3024×1890', 'at 120 fps, measured'],
  ['HEVC, H.264, AV1', 'HDR10 and 4:4:4 colour'],
  ['Stereo to 7.1', 'Opus audio'],
  ['ML-KEM-768', 'post-quantum, every packet'],
  ['Direct connections', 'NAT traversal, no relay'],
  ['macOS, Windows, Linux', 'client and host on each'],
];
---

<div class="wrap">
  <dl class="specs">
    {specs.map(([a, b]) => (
      <div>
        <dt>{a}</dt>
        <dd>{b}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0 0 clamp(64px, 8vw, 112px);
  }

  /* One strip: each item as wide as its words, the room left shared exactly
     between them. Equal columns would leave uneven gaps, as the words differ. */
  @media (min-width: 1040px) {
    .specs {
      display: flex;
      justify-content: space-between;
      white-space: nowrap;
    }
  }

  dt {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  dd {
    margin: 2px 0 0;
    color: var(--text-3);
    font-size: 0.875rem;
  }

  @media (max-width: 560px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
