---
//! Downloads: one button, for the system the browser says it is on, and a
//! line of links to the other platforms under the steps beside it. A phone or
//! tablet, where Helio does not run, is told to open the page on a computer
//! instead. Without script, or on a system it cannot name, all the systems are
//! shown and the line closes the card. Script also reads the sizes and the build
//! from latest.json.
import Command from './Command.astro';
import Icon from './Icon.astro';
import { REPO, TAP, onGitHub } from '../lib/repo';
import { CHECKSUMS, FILES, MANIFEST, type File, type System } from '../lib/downloads';

interface Panel {
  system: System;
  name: string;
  needs: string;
  file: File;
  /** What the button says under the system's name, when there is a choice. */
  detail?: string;
  /** HTML: the steps hold names in bold, paths and links. */
  steps: string[];
  commands: { label: string; lines: string[] }[];
  /** What the system may do about the download, under its button. */
  caveat?: string;
}

const panels: Panel[] = [
  {
    system: 'macos',
    name: 'macOS',
    needs: 'macOS 14 or later',
    file: FILES.macArm,
    detail: 'Apple silicon',
    steps: [
      'Open the DMG and drag <strong>Helio</strong> to Applications.',
      'Open Helio, and let it find devices on your local network when it asks.',
    ],
    commands: [{ label: 'Or with Homebrew', lines: [TAP, 'brew install --cask helio'] }],
  },
  {
    system: 'windows',
    name: 'Windows',
    needs: 'Windows 10 or 11, 64-bit',
    file: FILES.windows,
    steps: [
      'Open the installer. It installs Helio for you, with no administrator needed.',
      'Allow Helio on private networks when Windows Firewall asks.',
      'Helio is in the Start menu, and in <strong>Settings &gt; Apps &gt; Installed apps</strong>, which uninstalls it.',
    ],
    commands: [],
    caveat:
      'SmartScreen may say it prevented an unrecognized app from starting: choose More info, check the publisher, then Run anyway.',
  },
  {
    system: 'linux',
    name: 'Linux',
    needs: 'Ubuntu 24.04 or a distribution built on it, x86_64',
    file: FILES.linux,
    steps: [
      'Unpack it and run <code>./install.sh</code> in its folder: Helio goes in <code>~/.local/bin</code> and in your launcher.',
      'Open Helio from your launcher.',
    ],
    commands: [
      {
        label: 'Or in a terminal',
        lines: [`curl -L ${FILES.linux.url} | tar xz`, 'Helio-*-linux-x86_64/install.sh'],
      },
    ],
  },
];

const list = Object.values(FILES);

const steps = [
  ['Install', 'Helio on both computers. Turn on hosting on the one with the games: setup asks, or Settings → Hosting.'],
  ['Pair', 'Click the host in Helio and type the PIN it shows into the host’s Helio, under This computer → Devices. You do this once, on your network or through a VPN such as Tailscale.'],
  ['Stream', 'Click the host again, from anywhere. Ctrl+Alt+Shift+Q ends the stream.'],
];
const panelId = (system: System) => `download-${system}`;
---

<section class="section" id="install">
  <div class="wrap">
    <div class="head" data-on-phone hidden>
      <span class="eyebrow">Get started</span>
      <h2 class="title">Open this page on a computer</h2>
      <p class="lede">Helio runs on macOS, Windows and Linux. Open this page there to download it.</p>
    </div>

    <div class="head" data-on-computer>
      <span class="eyebrow">Get started</span>
      <h2 class="title">Download, pair and stream</h2>
      <p class="lede">Install Helio on both computers, and turn on hosting on the one with the games.</p>
    </div>

    <div class="picker" data-picker data-on-computer data-manifest={MANIFEST} data-repo={REPO}>
      {
        panels.map((p) => (
          <article class="panel" id={panelId(p.system)} aria-labelledby={`${panelId(p.system)}-title`} data-os={p.system}>
            <div class="get">
              <h3 id={`${panelId(p.system)}-title`}>Helio for {p.name}</h3>
              <p class="needs">{p.needs}</p>
              <div class="files">
                <a class="button primary" href={p.file.url} data-file={p.file.id}>
                  <Icon name="download" size={17} />
                  Download for {p.name}
                  {p.detail && <span class="detail">{p.detail}</span>}
                  <span class="size num" data-size />
                </a>
              </div>
              {p.caveat && <p class="caveat note">{p.caveat}</p>}
            </div>
            <div>
              <ol class="then">
                {p.steps.map((s) => (
                  <li set:html={s} />
                ))}
              </ol>
            </div>
            {p.commands.length > 0 && (
              <div class="commands">
                {p.commands.map((c) => (
                  <Command label={c.label} lines={c.lines} />
                ))}
              </div>
            )}
          </article>
        ))
      }

      <p class="others note" data-others>
        <span>Other platforms:</span>
        {
          list.map((f) => (
            <span data-listed={f.id}>
              <a href={f.url} data-file={f.id}>
                {f.label}
              </a>
            </span>
          ))
        }
      </p>

      <p class="build note">
        <span data-build>The newest build of the main branch.</span>
        <a href={CHECKSUMS}>SHA-256 checksums</a>
        <a href={`${REPO}/releases`}>All releases</a>
      </p>
    </div>

    <ol class="steps" data-on-computer>
      {
        steps.map(([t, d]) => (
          <li>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))
      }
    </ol>
    <p class="note after" data-on-computer>
      Helio offers each new release and installs it when you choose. Building from source takes Rust 1.96 or newer.
      <a href={onGitHub('docs/install.md')}>Installing, step by step</a>
    </p>
  </div>
</section>

<style>
  .picker {
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 28px 48px;
    padding: 28px 24px;
  }

  .get h3 {
    font-size: 1.375rem;
    letter-spacing: -0.015em;
  }

  .needs {
    margin-top: 4px;
    color: var(--text-3);
    font-size: 0.875rem;
  }

  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .size:not(:empty),
  .detail {
    font-weight: 400;
    opacity: 0.7;
  }

  .caveat {
    max-width: 30rem;
    margin-top: 16px;
  }

  .files [data-missing] {
    pointer-events: none;
    opacity: 0.45;
  }

  /* A long label on a narrow phone wraps inside the button. */
  .files .button {
    flex-wrap: wrap;
    max-width: 100%;
    white-space: normal;
  }

  .then {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: then;
    font-size: 0.9375rem;
  }

  .then li {
    position: relative;
    padding-left: 36px;
    counter-increment: then;
  }

  .then li + li {
    margin-top: 12px;
  }

  .then li::before {
    content: counter(then);
    position: absolute;
    top: 1px;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--text);
    font-size: 0.75rem;
  }

  .then :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .then :global(code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .commands {
    grid-column: 1 / -1;
    display: grid;
    gap: 16px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 14px 0 0;
  }

  .picker > .others {
    margin: 0;
    padding: 0 24px 20px;
  }

  .others [data-missing] {
    color: var(--text-3);
    text-decoration: none;
    pointer-events: none;
  }

  .build {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    max-width: none;
    margin: 0;
    padding: 0 24px 20px;
  }

  .build span {
    margin-right: auto;
  }

  .steps {
    margin-top: var(--gap-part);
  }

  .after {
    margin-top: var(--gap-note);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .panel,
    .picker > .others,
    .build {
      padding-inline: 16px;
    }
  }
</style>

<script>
  // The visitor's system, chosen for them: its panel and its one button,
  // with the line of other platforms moved up under the steps. A phone or
  // tablet gets the note instead, whatever the width: a narrow window on a
  // computer can still download. Then what latest.json says of the build: its
  // commit and date, the button's size. A file it does not list is not built
  // yet.
  const picker = document.querySelector<HTMLElement>('[data-picker]')!;
  const ua = navigator.userAgent;
  // An iPad says it is a Mac; only its touch screen gives it away.
  const phone = /Android|iPhone|iPad/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  for (const part of document.querySelectorAll<HTMLElement>('[data-on-computer]')) part.hidden = phone;
  document.querySelector<HTMLElement>('[data-on-phone]')!.hidden = !phone;
  const system = /Windows/.test(ua)
    ? 'windows'
    : phone
      ? null
      : /Macintosh/.test(ua)
        ? 'macos'
        : /Linux|X11|CrOS/.test(ua)
          ? 'linux'
          : null;
  if (system) {
    for (const panel of picker.querySelectorAll<HTMLElement>('.panel')) {
      panel.hidden = panel.dataset.os !== system;
      if (panel.hidden) continue;
      const shown = panel.querySelector<HTMLElement>('[data-file]')!.dataset.file;
      for (const row of picker.querySelectorAll<HTMLElement>('[data-listed]')) {
        row.hidden = row.dataset.listed === shown;
      }
      panel.querySelector('.then')!.after(picker.querySelector('[data-others]')!);
    }
  }

  interface Manifest {
    version: string;
    commit: string;
    published: string;
    files: Record<string, { url: string; size: number }>;
  }

  const megabytes = (n: number) => `${(n / 1e6).toFixed(1)} MB`;

  fetch(picker.dataset.manifest!, { cache: 'no-cache' })
    .then((r) => (r.ok ? (r.json() as Promise<Manifest>) : Promise.reject(r.status)))
    .then((m) => {
      const commit = m.commit.slice(0, 7);
      for (const link of picker.querySelectorAll<HTMLAnchorElement>('[data-file]')) {
        const file = m.files[link.dataset.file!];
        const size = link.querySelector('[data-size]');
        if (!file) {
          link.dataset.missing = '';
          link.setAttribute('aria-disabled', 'true');
          link.removeAttribute('href');
          link.tabIndex = -1;
          // The manifest may arrive while this link has focus. Return to
          // the section's next link instead of leaving focus on nothing.
          if (document.activeElement === link) picker.querySelector<HTMLAnchorElement>('.build > a')!.focus();
          if (size) size.textContent = 'not built yet';
          continue;
        }
        // The commit makes each build's link its own: a browser that kept
        // an earlier download does not hand it back.
        link.href = `${file.url}?${commit}`;
        if (size) size.textContent = megabytes(file.size);
      }
      const date = new Date(m.published).toLocaleDateString('en', { dateStyle: 'long' });
      const build = picker.querySelector('[data-build]')!;
      build.textContent = 'Built from ';
      const link = document.createElement('a');
      link.href = `${picker.dataset.repo}/commit/${m.commit}`;
      link.textContent = commit;
      build.append(link, ` on ${date}.`);
    })
    .catch(() => {
      // No answer: the links still point at the newest build.
    });
</script>
