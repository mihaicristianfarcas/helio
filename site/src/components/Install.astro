---
//! Downloads: one button, for the system the browser says it is on, and a
//! line of links to the other platforms under the steps beside it. Without
//! script, or on a system it cannot name, all the systems are shown and the line
//! closes the card. A phone or tablet, where Helio does not run, never sees this
//! section (global.css), and its download buttons say why (layouts/Base.astro).
//! The build writes in the release the downloads are, from latest.json
//! (lib/release.ts): its version, its sizes and its links, so the card does
//! not move as the page loads. Script reads latest.json again, and changes the
//! card only for a newer release.
import Command from './Command.astro';
import SystemMark from './SystemMark.astro';
import { REPO, TAP } from '../lib/repo';
import { CHECKSUMS, FILES, MANIFEST, type File, type System } from '../lib/downloads';
import { day, megabytes, release } from '../lib/release';

interface Panel {
  system: System;
  name: string;
  needs: string;
  file: File;
  /** What the button says under the system's name, when there is a choice. */
  detail?: string;
  /** HTML: the steps hold names in bold, paths and links. */
  steps: string[];
  commands: { label: string; lines: string[] }[];
  /** What the system may do about the download, under its button. */
  caveat?: string;
}

const panels: Panel[] = [
  {
    system: 'macos',
    name: 'macOS',
    needs: 'macOS 14 or later; tested on macOS 26',
    file: FILES.macArm,
    detail: 'Apple silicon',
    steps: [
      'Open the zip and move <strong>Helio</strong> to Applications.',
      'Open Helio, and let it find devices on your local network when it asks.',
    ],
    commands: [{ label: 'Or with Homebrew', lines: [TAP, 'brew install --cask helio'] }],
  },
  {
    system: 'windows',
    name: 'Windows',
    needs: 'Windows 10 or 11, 64-bit; tested on Windows 11',
    file: FILES.windows,
    steps: [
      'Open the installer. It installs Helio for you, with no administrator needed.',
      'Allow Helio on private networks when Windows Firewall asks.',
      'Helio is in the Start menu, and in <strong>Settings &gt; Apps &gt; Installed apps</strong>, which uninstalls it.',
    ],
    commands: [],
    caveat:
      'SmartScreen will probably say it prevented an unrecognized app from starting: choose More info, check that the publisher ends in Open Source Developer Farcaș Mihai-Cristian, then Run anyway.',
  },
  {
    system: 'linux',
    name: 'Linux',
    needs: 'Ubuntu 24.04 or a distribution built on it, x86_64',
    file: FILES.linux,
    steps: [
      'Unpack it and run <code>./install.sh</code> in its folder: Helio goes in <code>~/.local/bin</code> and in your launcher.',
      'Open Helio from your launcher.',
    ],
    commands: [
      {
        label: 'Or in a terminal',
        lines: [`curl -L ${FILES.linux.url} | tar xz`, 'Helio-*-linux-x86_64/install.sh'],
      },
    ],
  },
];

const list = Object.values(FILES);

const steps = [
  ['Install', 'Helio on both computers. Turn on hosting on the one with the games: setup asks, or Settings → Hosting.'],
  ['Pair', 'Click the host in Helio and type the PIN it shows into the host’s Helio, under This computer → Devices. You do this once, on your network or through a VPN such as Tailscale.'],
  ['Stream', 'Click the host again, from anywhere. Ctrl+Alt+Shift+Q ends the stream.'],
];
const panelId = (system: System) => `download-${system}`;
const built = await release();
const commit = built?.commit.slice(0, 7);
/**
 * A download as the release the page is built with has it: its address with
 * the commit (a browser that kept an earlier build does not hand it back) and
 * its size, or, where the release lacks it, not built yet. Without a release,
 * the fixed address alone, for the script to complete.
 */
const download = (f: File) => {
  if (!built) return { href: f.url, size: '', missing: false };
  const file = built.files[f.id];
  return file
    ? { href: `${file.url}?${commit}`, size: megabytes(file.size), missing: false }
    : { href: undefined, size: 'not built yet', missing: true };
};
const missing = (f: File) =>
  download(f).missing ? { 'data-missing': '', 'aria-disabled': 'true' as const, tabindex: -1 } : {};
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="install" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <h2 class="statement" id="install-title">
      Download, pair and stream. <span class="rest">Install Helio on both computers.</span>
    </h2>

    <div class="picker" data-picker data-manifest={MANIFEST} data-repo={REPO} data-commit={built?.commit}>
      {
        panels.map((p) => (
          <article class="panel" id={panelId(p.system)} aria-labelledby={`${panelId(p.system)}-title`} data-os={p.system}>
            <div class="get">
              <h3 id={`${panelId(p.system)}-title`}>Helio for {p.name}</h3>
              <p class="needs">{p.needs}</p>
              <div class="files">
                <a class="button primary" href={download(p.file).href} data-file={p.file.id} {...missing(p.file)}>
                  <SystemMark system={p.system} />
                  Download for {p.name}
                  {p.detail && <span class="detail">{p.detail}</span>}
                  <span class="size num" data-size>
                    {download(p.file).size}
                  </span>
                </a>
              </div>
              {p.caveat && <p class="caveat note">{p.caveat}</p>}
            </div>
            <div>
              <ol class="then">
                {p.steps.map((s) => (
                  <li set:html={s} />
                ))}
              </ol>
            </div>
            {p.commands.length > 0 && (
              <div class="commands">
                {p.commands.map((c) => (
                  <Command label={c.label} lines={c.lines} />
                ))}
              </div>
            )}
          </article>
        ))
      }

      <p class="others note" data-others>
        <span>Other platforms:</span>
        {
          list.map((f) => (
            <span data-listed={f.id}>
              <a href={download(f).href} data-file={f.id} {...missing(f)}>
                {f.label}
              </a>
            </span>
          ))
        }
      </p>

      <p class="build note">
        <span data-build>
          {
            built ? (
              <>
                Version {built.version}, built from <a href={`${REPO}/commit/${built.commit}`}>{commit}</a>
                {` on ${day(built.published)}.`}
              </>
            ) : (
              'The newest released version.'
            )
          }
        </span>
        <a href={CHECKSUMS}>SHA-256 checksums</a>
        <a href={`${REPO}/releases`}>All releases</a>
      </p>
    </div>

    <p class="note after">
      Helio offers each new release and installs it when you choose. Building from source takes Rust 1.96 or newer.
      <a href={`${base}docs/install/`}>Installing, step by step</a>
    </p>

    <ol class="steps">
      {
        steps.map(([t, d], i) => (
          <li>
            <h3>
              <span class="step num" aria-hidden="true">
                {i + 1}
              </span>
              {t}
            </h3>
            <p>{d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .install {
    padding-block: var(--gap-section) clamp(64px, 8vw, 112px);
  }

  /* One screen tall, as every section of the page (Section.astro). */
  @media (min-width: 861px) and (min-height: 560px) {
    .install {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--nav-height, var(--nav)));
      /* The tallest section: centring gives it the room the others get
         from their padding. */
      padding-block: 8px;
    }
  }

  /* Framed as the other sections' cards are. */
  .picker {
    margin-top: var(--gap-head);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: min(24px, 2.6vh) 48px;
    padding: min(24px, 2.6vh) 28px;
  }

  .get h3 {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .needs {
    margin-top: 4px;
    color: var(--text-3);
    font-size: 0.875rem;
  }

  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .size:not(:empty),
  .detail {
    font-weight: 400;
    opacity: 0.7;
  }

  .caveat {
    max-width: 30rem;
    margin-top: 16px;
  }

  .files [data-missing] {
    pointer-events: none;
    opacity: 0.45;
  }

  /* A long label on a narrow phone wraps inside the button. */
  .files .button {
    flex-wrap: wrap;
    max-width: 100%;
    white-space: normal;
  }

  .then {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: then;
    font-size: 0.9375rem;
  }

  /* The panel's lines are step 1 in detail (Install, below): plain,
     muted numbers, so the badges stay with the three steps alone. */
  .then li {
    position: relative;
    padding-left: 24px;
    counter-increment: then;
  }

  .then li + li {
    margin-top: 12px;
  }

  .then li::before {
    content: counter(then) '.';
    position: absolute;
    top: 0;
    left: 0;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .then :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .then :global(code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .commands {
    grid-column: 1 / -1;
    display: grid;
    gap: 16px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 14px 0 0;
  }

  .picker > .others {
    margin: 0;
    padding: 0 28px 20px;
  }

  .others [data-missing] {
    color: var(--text-3);
    text-decoration: none;
    pointer-events: none;
  }

  .build {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    max-width: none;
    margin: 0;
    padding: 0 28px 20px;
  }

  .build span {
    margin-right: auto;
  }

  /* The steps, as the other sections' points: a row of three, each
     number beside its title where their icons sit. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: min(48px, 5vh) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 500;
  }

  .step {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--sky-4);
    font-size: 0.75rem;
  }

  .steps p {
    max-width: 24rem;
    margin-top: 6px;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .after {
    margin-top: 14px;
    font-size: 0.8125rem;
  }

  @media (max-width: 860px) {
    .panel,
    .steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .panel,
    .picker > .others,
    .build {
      padding-inline: 16px;
    }
  }
</style>

<script>
  // The visitor's system (layouts/Base.astro), chosen for them: its panel
  // and its one button, with the line of other platforms moved up under the
  // steps. Then latest.json again: the build wrote in the release it read
  // (data-commit), and only a newer one changes the card, its commit and
  // date, the sizes and the links. A file it does not list is not built yet.
  const picker = document.querySelector<HTMLElement>('[data-picker]')!;
  const system = document.documentElement.dataset.os;
  if (system) {
    for (const panel of picker.querySelectorAll<HTMLElement>('.panel')) {
      panel.hidden = panel.dataset.os !== system;
      if (panel.hidden) continue;
      const shown = panel.querySelector<HTMLElement>('[data-file]')!.dataset.file;
      for (const row of picker.querySelectorAll<HTMLElement>('[data-listed]')) {
        row.hidden = row.dataset.listed === shown;
      }
      panel.querySelector('.then')!.after(picker.querySelector('[data-others]')!);
    }
  }

  interface Manifest {
    version: string;
    commit: string;
    published: string;
    files: Record<string, { url: string; size: number }>;
  }

  // As lib/release.ts writes them at build: the script cannot import it.
  const megabytes = (n: number) => `${(n / 1e6).toFixed(1)} MB`;
  const day = (iso: string) => new Date(iso).toLocaleDateString('en', { dateStyle: 'long', timeZone: 'UTC' });

  fetch(picker.dataset.manifest!, { cache: 'no-cache' })
    .then((r) => (r.ok ? (r.json() as Promise<Manifest>) : Promise.reject(r.status)))
    .then((m) => {
      if (m.commit === picker.dataset.commit) return;
      picker.dataset.commit = m.commit;
      const commit = m.commit.slice(0, 7);
      for (const link of picker.querySelectorAll<HTMLAnchorElement>('[data-file]')) {
        const file = m.files[link.dataset.file!];
        const size = link.querySelector('[data-size]');
        if (!file) {
          link.dataset.missing = '';
          link.setAttribute('aria-disabled', 'true');
          link.removeAttribute('href');
          link.tabIndex = -1;
          // The manifest may arrive while this link has focus. Return to
          // the section's next link instead of leaving focus on nothing.
          if (document.activeElement === link) picker.querySelector<HTMLAnchorElement>('.build > a')!.focus();
          if (size) size.textContent = 'not built yet';
          continue;
        }
        // The commit makes each build's link its own: a browser that kept
        // an earlier download does not hand it back.
        delete link.dataset.missing;
        link.removeAttribute('aria-disabled');
        link.removeAttribute('tabindex');
        link.href = `${file.url}?${commit}`;
        if (size) size.textContent = megabytes(file.size);
      }
      const date = day(m.published);
      const build = picker.querySelector('[data-build]')!;
      build.textContent = `Version ${m.version}, built from `;
      const link = document.createElement('a');
      link.href = `${picker.dataset.repo}/commit/${m.commit}`;
      link.textContent = commit;
      build.append(link, ` on ${date}.`);
    })
    .catch(() => {
      // No answer: the links still point at the newest version.
    });
</script>
