---
//! One of a section's points, which stand in rows of three: an icon from
//! the app (or, in the icon slot, another's mark), a title, a sentence.
import Icon from './Icon.astro';

interface Props {
  /** One of the app's icons; leave it out to give a mark in the icon slot. */
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<li class="point">
  <h3><slot name="icon">{icon && <Icon name={icon} size={18} />}</slot>{title}</h3>
  <p><slot /></p>
</li>

<style>
  .point {
    min-width: 0;
    color: var(--text-2);
  }

  .point :global(svg) {
    color: var(--sky-4);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 500;
  }

  p {
    max-width: 24rem;
    margin-top: 6px;
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
