---
//! The bar at the top of every page, held there: the name, the
//! documentation, the repository with its stars, and the downloads. The
//! build's star count (lib/stars.ts) is in the markup, in a place kept for
//! it even when the build could not read one, so nothing in the bar moves
//! when the script refreshes it: at most once an hour per browser, as GitHub
//! allows an address 60 anonymous calls an hour and many share one.
import Logo from './Logo.astro';
import { REPO, REPO_API } from '../lib/repo';
import { short, stars } from '../lib/stars';

interface Props {
  /** The landing page links its own sections; every other page links back to them. */
  landing?: boolean;
}

const { landing = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = landing ? '#top' : base;
const download = landing ? '#install' : `${base}#install`;
const count = await stars();
const inDocs = Astro.url.pathname.startsWith(`${base}docs/`);
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a href={home} class="home" aria-label={landing ? 'Helio, top of the page' : 'Helio, home'}><Logo /></a>
    <div class="end">
      <a class="link" href={`${base}docs/`} aria-current={inDocs ? 'page' : undefined}>Docs</a>
      <a
        class="gh"
        href={REPO}
        aria-label={count === null ? 'Source on GitHub' : `Source on GitHub, ${count.toLocaleString('en')} stars`}
      >
        <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
        <span class="stars num" data-stars data-api={REPO_API} data-unknown={count === null ? '' : undefined}
          ><span data-count>{count === null ? '' : short(count)}</span></span
        >
      </a>
      <a class="button primary small" href={download}>Download</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
  }

  .nav[data-stuck] {
    box-shadow: 0 1px 0 var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav);
  }

  .home {
    display: flex;
    flex-shrink: 0;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .link,
  .gh {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding-inline: 9px;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    font-size: 0.84375rem;
  }

  .link:hover,
  .gh:hover,
  .link[aria-current] {
    color: var(--text);
  }

  /* The count beside the mark, as zeron.sh has it. */
  .stars {
    display: inline-flex;
  }

  /* Until a count is known, its place is kept, empty, with room for two
     figures: one arriving later then shows where it is, and the Docs link
     beside it stays put. */
  .stars[data-unknown] {
    visibility: hidden;
  }

  .stars [data-count] {
    min-width: 2ch;
  }

  /* The global max-width on pictures would let the marks shrink to
     nothing in a tight bar. */
  .gh svg {
    flex-shrink: 0;
  }

  .end .button {
    margin-left: 8px;
  }

  /* A 320 px phone: the four still fit on one line. */
  @media (max-width: 400px) {
    .bar {
      gap: 8px;
    }

    .end {
      gap: 0;
    }

    .link,
    .gh {
      padding-inline: 7px;
    }

    .end .button {
      margin-left: 4px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  // The sticky header may grow when text is enlarged. Scroll padding uses
  // its actual height so an anchored section or a focused control clears it.
  const measure = () => {
    const { height } = header.getBoundingClientRect();
    document.documentElement.style.setProperty('--nav-height', `${height}px`);
  };
  new ResizeObserver(measure).observe(header);
  measure();

  // The line marks what passes under the header, and at the top nothing does.
  // A position restored on reload arrives as a scroll too.
  const stick = () => header.toggleAttribute('data-stuck', window.scrollY > 0);
  window.addEventListener('scroll', stick, { passive: true });
  stick();

  // The stars: what the build read is already there. A figure this browser
  // saved replaces it at once, however old, rather than wait for GitHub: it is
  // usually the later reading, and a visit after a deploy that predates it
  // shows the older number only until GitHub answers. One under an hour old is
  // all the page asks for. Any failure (offline, over the limit, storage
  // refused) leaves what the page has.
  const stars = header.querySelector<HTMLElement>('[data-stars]');
  if (stars) {
    // The hero's Star on GitHub carries the same count.
    const KEY = 'helio:stars';
    const HOUR = 3_600_000;
    const show = (count: number) => {
      const text = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 })
        .format(count)
        .toLowerCase();
      for (const figure of document.querySelectorAll('[data-count]')) figure.textContent = text;
      stars.removeAttribute('data-unknown');
      stars.parentElement!.setAttribute('aria-label', `Source on GitHub, ${count.toLocaleString('en')} stars`);
    };
    const valid = (count: unknown): count is number => Number.isSafeInteger(count) && (count as number) >= 0;
    const refresh = async () => {
      let saved: { count: number; at: number } | null = null;
      try {
        const kept = JSON.parse(localStorage.getItem(KEY) ?? 'null');
        if (kept && valid(kept.count) && Number.isFinite(kept.at)) saved = kept;
      } catch {}
      if (saved) {
        show(saved.count);
        if (Date.now() - saved.at < HOUR) return;
      }
      try {
        const response = await fetch(stars.dataset.api!, { headers: { accept: 'application/vnd.github+json' } });
        if (!response.ok) return;
        const { stargazers_count: count } = await response.json();
        if (!valid(count)) return;
        show(count);
        localStorage.setItem(KEY, JSON.stringify({ count, at: Date.now() }));
      } catch {}
    };
    refresh();
  }
</script>
