---
//! AI agents on your hosts (docs/ai-agents.md): the agent's session as Helio
//! shows it, the end of that session as its chat draws it (the app's
//! sample, helio-app/src/chat/sample.rs, and view.rs: your messages in
//! bubbles on the right, the agent's steps and reply as plain text, its
//! request for a go-ahead in the window's own words), five of the rules
//! the host holds it to, and the models it can run on.
import { Image } from 'astro:assets';
import Card from './Card.astro';
import Icon from './Icon.astro';
import Point from './Point.astro';
import Section from './Section.astro';
import session from '../assets/windows/agent.webp';
---

<Section
  id="agents"
  lead="Let AI agents use your computers."
  rest="Under rules the host enforces."
>
  <Card slot="cards" title="Watch it, or take over">
    Hand it a task in Helio, or give your own agent your hosts through MCP. See every step, and take the keyboard and
    mouse back with <span class="chord"><kbd>Ctrl</kbd> <kbd>Alt</kbd> <kbd>Shift</kbd> <kbd>T</kbd></span>.
    <div slot="visual" class="bleed">
      <div class="shot">
        <Image
          src={session}
          alt="An agent session in Helio: a conversation about the Downloads folder, the agent waiting for a go-ahead to empty the Recycle Bin, the Windows desktop it saw after its last step, and its plan."
          widths={[640, 960, 1280]}
          sizes="(max-width: 860px) 90vw, 640px"
        />
      </div>
    </div>
  </Card>
  <Card slot="cards" title="It asks first">
    It stops for your go-ahead before anything risky, like deleting files, sending messages or installing software.
    <div slot="visual" class="thread" aria-hidden="true">
      <div class="history">
        <p class="you">Yes, both. Keep the recordings.</p>
        <div class="acts">
          <p class="acts-title"><Icon name="cursor-click" size={13} /> Used the computer, 3 actions</p>
          <ul>
            <li><Icon name="check" size={12} /><code>left_click (402, 188)</code></li>
            <li><Icon name="check" size={12} /><code>key ctrl+left_click (402, 214)</code></li>
            <li><Icon name="check" size={12} /><code>key Delete</code><span>moved to the Recycle Bin</span></li>
          </ul>
        </div>
        <p class="reply">Done: both are in the <strong>Recycle Bin</strong>. The recordings are where they were.</p>
        <p class="you">Empty it too.</p>
      </div>
      <div class="ask">
        <p class="ask-title"><Icon name="hand" size={18} /> The agent asks for your go-ahead</p>
        <div class="ask-row">
          <p class="ask-what">Empty the Recycle Bin (8.9 GB, 2 items)</p>
          <p class="ask-buttons"><span class="allow">Allow</span><span class="deny">Don’t</span></p>
        </div>
      </div>
    </div>
  </Card>
  <Point slot="points" icon="user" title="Never over a person">An agent is refused while a person streams.</Point>
  <Point slot="points" icon="hand" title="A person always wins">Starting a stream takes over from an agent.</Point>
  <Point slot="points" icon="lock" title="Secure screens are a person’s">
    At a sign-in or lock screen, or a UAC prompt, its input is held.
  </Point>
  <Point slot="points" icon="keyboard" title="Someone at the host comes first">
    Input at the host holds the agent until 10 s after it stops.
  </Point>
  <Point slot="points" icon="shield" title="Its own permissions">
    Like any device: what it may see and use, and whether it may act unwatched.
  </Point>
  <Point slot="points" icon="agent" title="Your model">
    Codex, Claude Code, an API key, OpenRouter, or a model of your own through Ollama.
  </Point>
</Section>

<style>
  .chord {
    white-space: nowrap;
  }

  .bleed {
    flex: 1;
    min-height: 0;
    padding-left: 28px;
    margin-bottom: -1px;
  }

  .bleed .shot {
    border-right: 0;
    border-bottom: 0;
    border-radius: 12px 0 0 0;
  }

  /* The session's last lines, held to the card's foot as a chat is: the
     request whole at the bottom, what came before it above. */
  .thread,
  .history {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    min-height: 0;
    overflow: hidden;
  }

  .thread {
    flex: 1;
    padding: 0 28px 24px;
  }

  /* Where the card is a share of the screen's height, the oldest lines run
     off the top on a short screen, under a fade, as in a thread scrolled to
     its end. The fade starts under the card's own gap below its text, and
     is tall enough that the line it cuts reads as going, not as crowding
     the text; the request is outside it, so it is never faded, even where
     it is all the card has room for (1280x720). */
  @media (min-width: 861px) {
    .history {
      -webkit-mask-image: linear-gradient(transparent, #000 40px);
      mask-image: linear-gradient(transparent, #000 40px);
    }
  }

  /* Its steps, as the window folds them: a line saying what it used, the
     actions under it on a rule. */
  .acts {
    flex-shrink: 0;
    min-width: 0;
    font-size: 0.75rem;
  }

  .acts-title {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
  }

  .acts ul {
    display: grid;
    gap: 3px;
    margin: 2px 0 0 6px;
    padding: 0 0 0 12px;
    border-left: 1px solid var(--line-2);
    list-style: none;
  }

  .acts li {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    color: var(--text-3);
    white-space: nowrap;
  }

  .acts li :global(svg) {
    flex-shrink: 0;
    color: var(--sky-4);
  }

  .acts code {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-2);
  }

  .reply,
  .you {
    flex-shrink: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* The agent's reply is the thread's own text, as in the app; yours is a
     bubble on the right (helio-app/src/chat/view.rs). */
  .reply {
    color: var(--text);
  }

  .reply strong {
    font-weight: 600;
  }

  .you {
    align-self: flex-end;
    max-width: 82%;
    padding: 8px 12px;
    border-radius: 12px;
    background: rgb(var(--sky-5-rgb) / 0.22);
    color: var(--text);
  }

  .ask {
    flex-shrink: 0;
    padding: 14px 18px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: rgb(var(--sky-5-rgb) / 0.1);
    transition:
      translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.5s ease;
  }

  /* While the card is hovered, as the cards with pictures move (Card.astro):
     the request rises toward you and its hand waves once. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.card:hover) .ask {
      translate: 0 -4px;
      border-color: rgb(var(--sky-5-rgb) / 0.45);
    }

    :global(.card:hover) .ask-title :global(svg) {
      animation: ask-wave 0.9s ease-in-out;
    }
  }

  @keyframes ask-wave {
    20% {
      rotate: -14deg;
    }
    45% {
      rotate: 12deg;
    }
    70% {
      rotate: -6deg;
    }
  }

  .ask-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 500;
  }

  .ask-title :global(svg) {
    color: var(--sky-4);
  }

  /* What it asks, with the buttons beside it where they fit, and under it
     where they do not. */
  .ask-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-top: 8px;
  }

  .ask-what {
    color: var(--text);
    font-size: 0.95rem;
  }

  .ask-buttons {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .allow,
  .deny {
    padding: 6px 14px;
    border-radius: 8px;
  }

  .allow {
    background: var(--sky-2);
    color: var(--ink);
  }

  .deny {
    border: 1px solid var(--line-2);
    color: var(--text);
  }
</style>
