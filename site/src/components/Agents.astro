---
//! AI agents on your hosts (docs/ai-agents.md): the agent's session as Helio
//! shows it, the end of that session (the app's sample, helio-app/src/chat/
//! sample.rs) with its request for a go-ahead in the window's own words, and
//! three of the rules the host holds it to.
import { Image } from 'astro:assets';
import Card from './Card.astro';
import Icon from './Icon.astro';
import Point from './Point.astro';
import Section from './Section.astro';
import session from '../assets/windows/agent.webp';
---

<Section
  id="agents"
  lead="Let AI agents use your computers."
  rest="Under rules the host enforces."
>
  <Card slot="cards" title="Watch it, or take over">
    Hand it a task in Helio, or give your own agent your hosts through MCP. See every step, and take the keyboard and
    mouse back with <span class="chord"><kbd>Ctrl</kbd> <kbd>Alt</kbd> <kbd>Shift</kbd> <kbd>T</kbd></span>.
    <div slot="visual" class="bleed">
      <div class="shot">
        <Image
          src={session}
          alt="An agent session in Helio: a conversation about the Downloads folder, the agent waiting for a go-ahead to empty the Recycle Bin, the Windows desktop it saw after its last step, and its plan."
          widths={[640, 960, 1280]}
          sizes="(max-width: 860px) 90vw, 640px"
        />
      </div>
    </div>
  </Card>
  <Card slot="cards" title="It asks first">
    It stops for your go-ahead before anything risky, like deleting files, sending messages or installing software.
    <div slot="visual" class="thread" aria-hidden="true">
      <ul class="acts">
        <li><Icon name="check" size={14} /><code>left_click (402, 188)</code></li>
        <li><Icon name="check" size={14} /><code>key ctrl+left_click (402, 214)</code></li>
        <li><Icon name="check" size={14} /><code>key Delete</code><span>moved to the Recycle Bin</span></li>
      </ul>
      <p class="you">Empty it too.</p>
      <div class="ask">
        <p class="ask-title"><Icon name="hand" size={18} /> The agent asks for your go-ahead</p>
        <div class="ask-row">
          <p class="ask-what">Empty the Recycle Bin (8.9 GB, 2 items)</p>
          <p class="ask-buttons"><span class="allow">Allow</span><span class="deny">Don’t</span></p>
        </div>
      </div>
    </div>
  </Card>
  <Point slot="points" icon="user" title="Never over a person">An agent is refused while a person streams.</Point>
  <Point slot="points" icon="hand" title="A person always wins">Starting a stream takes over from an agent.</Point>
  <Point slot="points" icon="lock" title="Secure screens are a person’s">
    At a sign-in or lock screen, or a UAC prompt, its input is held.
  </Point>
</Section>

<style>
  .chord {
    white-space: nowrap;
  }

  .bleed {
    flex: 1;
    min-height: 0;
    padding-left: 28px;
    margin-bottom: -1px;
  }

  .bleed .shot {
    border-right: 0;
    border-bottom: 0;
    border-radius: 12px 0 0 0;
  }

  /* The session's last lines, held to the card's foot as a chat is. */
  .thread {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    min-height: 0;
    padding: 0 28px 24px;
    overflow: hidden;
  }

  /* Where the card is a share of the screen's height, the oldest lines run
     off the top on a short screen, under a fade, as in a thread scrolled to
     its end: the agent's steps are cut, never gone. The fade takes the
     place of the gap under the card's text. */
  @media (min-width: 861px) {
    .thread {
      margin-top: -24px;
      -webkit-mask-image: linear-gradient(transparent, #000 28px);
      mask-image: linear-gradient(transparent, #000 28px);
    }
  }

  .acts {
    display: grid;
    flex-shrink: 0;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  .acts li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--text-3);
  }

  .acts :global(svg) {
    flex-shrink: 0;
    color: var(--sky-4);
  }

  .acts code {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-2);
  }

  .you {
    flex-shrink: 0;
    align-self: flex-end;
    padding: 7px 12px;
    border-radius: 12px;
    background: rgb(var(--sky-5-rgb) / 0.18);
    color: var(--text);
    font-size: 0.875rem;
  }

  .ask {
    flex-shrink: 0;
    padding: 14px 18px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: rgb(var(--sky-5-rgb) / 0.1);
  }

  .ask-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 500;
  }

  .ask-title :global(svg) {
    color: var(--sky-4);
  }

  /* What it asks, with the buttons beside it where they fit, and under it
     where they do not. */
  .ask-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-top: 8px;
  }

  .ask-what {
    color: var(--text);
    font-size: 0.95rem;
  }

  .ask-buttons {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .allow,
  .deny {
    padding: 6px 14px;
    border-radius: 8px;
  }

  .allow {
    background: var(--sky-2);
    color: var(--ink);
  }

  .deny {
    border: 1px solid var(--line-2);
    color: var(--text);
  }
</style>
