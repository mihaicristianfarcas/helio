---
//! Why Helio over Moonlight, in the 1.0.0 benchmarks' figures (lib/facts.ts,
//! docs/benchmarks.md): four numbers, each with Moonlight's beside it and
//! the mode it was taken at: frames shown, frames shown while the link
//! narrows, a stream's start, and a click in a game. The conditions sit
//! under the card, and every figure links to the page that measured it.
import Point from './Point.astro';
import Section from './Section.astro';
import { CLICK, FRAMES, HOUR, LOSS, NARROWING, SETUP, START, type Versus } from '../lib/facts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pct = (v: number) => `${Math.round(v)}%`;
const theirs = (v: Versus, show: (n: number) => string) => {
  const [low, high] = [Math.min(v.apollo, v.sunshine), Math.max(v.apollo, v.sunshine)];
  return show(low) === show(high) ? show(low) : `${show(low).replace(/[^\d.]+$/, '')}–${show(high)}`;
};
const click = CLICK.find((c) => c.mode === '1440p at 120 fps')!;
const tiles = [
  {
    figure: pct(FRAMES.helio),
    what: 'of the host’s frames reach your screen',
    moonlight: theirs(FRAMES, pct),
    mode: '1440p at 120 fps',
  },
  {
    figure: pct(NARROWING.helio),
    what: 'still shown when the link narrows to 20 Mbit/s',
    moonlight: theirs(NARROWING, pct),
    mode: '1440p at 60 fps',
  },
  {
    figure: `${START.helio.toFixed(1)} s`,
    what: 'to start a stream',
    moonlight: theirs(START, (n) => `${n.toFixed(1)} s`),
    mode: '1440p at 120 fps',
  },
  {
    figure: `${click.helio.toFixed(1)} ms`,
    what: 'from a click in a game to your screen',
    moonlight: theirs(click, (n) => `${n.toFixed(1)} ms`),
    mode: '1440p at 120 fps',
  },
];
---

<Section id="latency" lead="Smoother than Moonlight, and as fast." rest="Side by side, on the same two computers.">
  <div slot="cards" class="board">
    {
      tiles.map((t) => (
        <div class="tile">
          <p class="figure num">{t.figure}</p>
          <p class="what">{t.what}</p>
          <p class="theirs num">Moonlight: {t.moonlight}</p>
          <p class="mode">{t.mode}</p>
        </div>
      ))
    }
  </div>
  <p class="setup">
    {SETUP} <a href={`${base}docs/benchmarks/`}>Every figure, and how it was taken</a>
  </p>
  <Point slot="points" icon="wifi-off" title={`${pct(LOSS.helio)} with 5% of packets lost`}>
    Helio rebuilds what a bad link drops; Moonlight shows {theirs(LOSS, pct)} of the frames.
  </Point>
  <Point slot="points" icon="clock" title={`${pct(HOUR.helio)} over an hour`}>
    Frames shown, minute after minute, at 1440p and 120 fps; Moonlight {theirs(HOUR, pct)}.
  </Point>
  <Point slot="points" icon="chart-bar" title="Every figure, with its conditions">
    Every mode from 1080p to 4K, bad links and hour-long streams, in the
    <a href={`${base}docs/benchmarks/`}>benchmarks</a>.
  </Point>
</Section>

<style>
  /* One card of four figures, split by rules. */
  .board {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(20px, 3vh, 32px) 28px;
  }

  .tile + .tile {
    border-left: 1px solid var(--line);
  }

  .figure {
    color: var(--text);
    font-size: clamp(2.5rem, 1.6rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .what {
    margin-top: 14px;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.4;
  }

  .theirs {
    margin-top: auto;
    padding-top: 18px;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .mode {
    margin-top: 2px;
    color: var(--text-3);
    font-size: 0.8125rem;
  }

  .setup {
    max-width: 60rem;
    margin-top: 14px;
    color: var(--text-3);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile:nth-child(3) {
      border-left: 0;
    }

    .tile:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile + .tile {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
