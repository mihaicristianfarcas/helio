---
//! The top of a page, one screen tall: a badge, the title, a line of what it
//! is and two actions, with two pictures beside them, one behind the other,
//! and an optional strip along the bottom. The home page and /agents share it,
//! so the two stay alike.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  badge?: { text: string; href?: string };
  /** The title in the phrases a line may break between; none is split. */
  title: string[];
  actions: { label: string; href: string; primary?: boolean }[];
  shots: { src: ImageMetadata; alt: string; place: 'back' | 'front' }[];
}

const { id, badge, title, actions, shots } = Astro.props;
---

<section class="hero" id={id}>
  <div class="wrap top">
    <div class="copy">
      {badge && (badge.href ? <a class="badge" href={badge.href}>{badge.text}</a> : <span class="badge">{badge.text}</span>)}
      <h1>{title.flatMap((phrase, i) => [i > 0 && ' ', <span class="phrase">{phrase}</span>])}</h1>
      <p class="lede"><slot /></p>
      <div class="actions">
        {actions.map((a) => (
          <a class:list={['button', a.primary ? 'primary' : 'secondary']} href={a.href}>
            {a.label}
          </a>
        ))}
      </div>
    </div>
    <div class="windows">
      <div class="pair">
        {shots.map((s, i) => (
          <figure class={s.place}>
            <Image
              src={s.src}
              alt={s.alt}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 959px) 84vw, 760px"
              loading="eager"
              fetchpriority={i === shots.length - 1 ? 'high' : undefined}
            />
          </figure>
        ))}
      </div>
    </div>
  </div>
  <slot name="foot" />
</section>

<style>
  /* One screen: the window under the header, down to the next section's rule.
     The pictures take what the text and the strip leave; on a window too
     short for the text, the hero grows to hold it. */
  .hero {
    display: grid;
    grid-template-rows: 1fr;
    row-gap: var(--gap-head);
    min-height: calc(100svh - var(--nav-height, var(--nav)));
    padding-block: var(--gap-head) clamp(48px, 6vw, 80px);
  }

  /* The text, then the pictures. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    column-gap: var(--gap-head);
  }

  /* The title's size follows the column's width. */
  .copy {
    max-width: var(--measure);
    container-type: inline-size;
  }

  .badge {
    display: inline-block;
    margin-bottom: 20px;
    padding: 3px 10px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.8125rem;
  }

  a.badge:hover {
    border-color: rgb(255 255 255 / 0.28);
    color: var(--text);
    text-decoration: none;
  }

  /* As large as the window allows, and never so large that the longest phrase,
     "and game streaming" at 9.41 em in Geist, misses the column: 9.5 em
     leaves a little for other browsers' rounding. So beside the pictures the
     title is always the same three lines, and two on a wider column. */
  h1 {
    font-size: min(clamp(2.25rem, 1.25rem + 3vw, 3.75rem), 100cqi / 9.5);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .phrase {
    white-space: nowrap;
  }

  .lede {
    margin-top: 20px;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* The room the pictures have: their column, as tall as the row. Sized by
     the row, not by the pictures, so the pictures can fit it. */
  .windows {
    align-self: stretch;
    display: grid;
    align-items: center;
    justify-items: end;
    container-type: size;
  }

  /* One picture behind, up and to the right; the other in front of it, lower
     and to the left. Both in one grid cell; the offset is a share of the
     width, so the pair keeps its shape at every size. The front one is the
     lower, so the pair is --drop plus --share of 3:2 of its width tall, which
     caps its width at the room's height. */
  .pair {
    --share: 0.84;
    --drop: 0.13;
    display: grid;
    width: min(100cqw, 100cqh / (var(--drop) + var(--share) * 2 / 3));
  }

  .pair > figure {
    grid-area: 1 / 1;
    width: calc(var(--share) * 100%);
    margin: 0;
  }

  .pair > .back {
    justify-self: end;
    align-self: start;
  }

  .pair > .front {
    z-index: 1;
    justify-self: start;
    margin-top: calc(var(--drop) * 100%);
  }

  .pair :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 14px;
    box-shadow: 0 30px 80px -24px rgb(0 0 0 / 0.75);
    /* To look at only: not dragged, selected or opened on their own. */
    pointer-events: none;
  }

  /* Too narrow for the title beside the pictures: the pictures go under it,
     the width of the page, and take the height they need. */
  @media (max-width: 959px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      row-gap: var(--gap-part);
    }

    .windows {
      container-type: normal;
    }

    .pair {
      width: 100%;
    }
  }
</style>
