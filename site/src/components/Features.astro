---
//! What Helio does beyond the stream itself. The words follow README.md,
//! docs/parity.md, docs/networking.md and docs/usage.md.
import { TUNNEL } from '../lib/facts';

const features = [
  {
    title: 'Post-quantum encryption',
    text: `Picture, sound, input and clipboard share one WireGuard tunnel with ML-KEM-768, at ${TUNNEL.encrypt1200} per 1,200-byte packet. Pairing is a hybrid SPAKE2 + ML-KEM exchange over a PIN.`,
  },
  {
    title: 'Reach your host from anywhere',
    text: 'Hosts publish sealed records on the BitTorrent DHT and both sides punch through their NATs, with no relay or separate VPN. Symmetric NAT on both sides may need a forwarded port.',
  },
  {
    title: 'Recovery from packet loss',
    text: 'Reed-Solomon parity, sized to the link’s loss, rebuilds what Wi-Fi drops. When it cannot, Helio asks for a fresh reference frame, as Moonlight does.',
  },
  {
    title: 'Your screen’s exact mode, in HDR',
    text: 'Hosts create a virtual display at your screen’s exact resolution and refresh rate, 59.94 Hz included (on Linux, GNOME or KDE under Wayland). HDR10 reaches Macs with HDR displays, and 4:4:4 keeps coloured text sharp.',
  },
  {
    title: 'Input that feels local',
    text: 'The mouse moves the way games expect, held keys repeat at your keyboard’s pace, and Moonlight’s shortcuts work.',
  },
  {
    title: 'Permissions for each device',
    text: 'See the screen, use input, copy and paste, start apps, take over a stream: choose what each paired device may do, as Apollo does. An agent can be limited to acting while someone watches.',
  },
  {
    title: 'A clipboard shared both ways',
    text: 'Text, images, files and folders, either way. Anything a password manager marks as concealed is never sent.',
  },
  {
    title: 'Surround sound and controllers',
    text: 'Up to 7.1 sound, from Mac hosts with a surround output too. Controllers reach Windows hosts as Xbox 360 pads, with rumble back about 7 ms after the host sets it.',
  },
  {
    title: 'A host set up for streaming',
    text: 'On Windows, Helio Host runs the NVIDIA GPU at full power, captures OpenGL and Vulkan games at full frame rate and puts Wi-Fi in streaming mode, as Sunshine does, then restores it all.',
  },
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Features</span>
      <h2 class="title">An open-source alternative to Moonlight and Sunshine/Apollo</h2>
      <p class="lede">
        One app, client and host, for remote desktop and game streaming. It behaves like Moonlight and
        Sunshine/Apollo, and adds post-quantum encryption and a two-way clipboard, files included. Compare
        <a href="#platforms">platform support</a> and the <a href="#latency">measured latency</a>.
      </p>
    </div>

    <ul class="grid">
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  li p {
    margin-top: 8px;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Nine tiles in two columns: the last one takes the row. */
    li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
