---
//! One section of the landing page, laid out as zeron.sh lays out its own: a
//! statement, its first sentence lit and the rest quiet, as the one heading;
//! framed cards under it; then a row of points under a rule.
interface Props {
  id: string;
  /** The first sentence, lit. */
  lead: string;
  /** The rest, quiet. */
  rest: string;
}

const { id, lead, rest } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <h2 class="statement" id={`${id}-title`}>{lead} <span class="rest">{rest}</span></h2>
    <div class="cards"><slot name="cards" /></div>
    <slot />
    {Astro.slots.has('points') && <ul class="points"><slot name="points" /></ul>}
  </div>
</section>

<style>
  /* As far from the rule under it as from the one above, where the
     sections stack (a phone, a narrow window). */
  .section {
    padding-block: var(--gap-section);
  }

  /* On a computer's screen each section is one screen tall under the
     header, its content in the middle, as the hero is. */
  @media (min-width: 861px) and (min-height: 560px) {
    .section {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--nav-height, var(--nav)));
      padding-block: clamp(24px, 4vh, 48px);
    }
  }

  /* The left card a little wider, as zeron.sh's. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    margin-top: var(--gap-head);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: min(48px, 5vh) 0 0;
    padding: 0;
    list-style: none;
  }

  /* A card holding a picture takes its height from the screen's
     (global.css); anything else in the row, its own. */
  @media (min-width: 861px) {
    .cards > :global(article) {
      height: var(--card-height);
    }
  }

  @media (max-width: 860px) {
    .cards,
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
