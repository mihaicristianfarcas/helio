---
//! The field that opens the documentation's search (Search.astro). It is a
//! button that looks like a search field, as most documentation's is: the
//! search itself is in a dialog, so its results are never cut by the
//! scrolling list of pages it sits above. `/` opens it from anywhere on
//! the page, which the key on its right says.
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button type="button" class:list={['search-open', className]} data-search-open aria-haspopup="dialog">
  <Icon name="search" size={16} />
  <span class="label">Search</span>
  <kbd aria-label="Shortcut: slash">/</kbd>
</button>

<style>
  .search-open {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 8px 7px 10px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--text-3);
    font: inherit;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
  }

  .search-open:hover {
    border-color: rgb(var(--sky-rgb) / 0.28);
    color: var(--text-2);
  }

  .label {
    flex: 1;
  }

  kbd {
    padding: 0 6px;
    border: 1px solid var(--line-2);
    border-radius: 5px;
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  /* A phone has no key to press. */
  @media (hover: none) {
    kbd {
      display: none;
    }
  }
</style>
