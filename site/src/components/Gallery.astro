---
//! Screenshots from the app's demo mode (docs/ui.md), with made-up hosts and
//! devices. The pages change by themselves until the reader picks one. Native
//! buttons put every choice in the page's Tab order; without script all
//! screenshots are shown and the buttons are hidden.
import { Image } from 'astro:assets';
import devices from '../assets/shots/devices.webp';
import video from '../assets/shots/video.webp';
import input from '../assets/shots/input.webp';
import hosting from '../assets/shots/hosting.webp';
import agents from '../assets/shots/agent-setup.webp';

const tabs = [
  {
    page: 'Devices',
    text: 'Pairing requests, and paired devices and agents, each with its own permissions.',
    img: devices,
    alt: 'Helio’s Devices page: a MacBook Air asking to pair, and three paired devices including an AI agent.',
  },
  {
    page: 'Video',
    text: 'Your display’s own mode by default, HDR and 4:4:4 colour, and a bitrate that picks itself, as in Moonlight.',
    img: video,
    alt: 'Helio’s Video settings: resolution and frame rate matching this display, the codec, display mode, HDR and YUV 4:4:4.',
  },
  {
    page: 'Input',
    text: 'The clipboard, a controller as a mouse, swapped buttons, reversed scrolling and Moonlight’s shortcuts.',
    img: input,
    alt: 'Helio’s Input settings: the Windows key, clipboard sharing, controller as a mouse, swapped mouse buttons, reverse scrolling, and the stream’s shortcuts.',
  },
  {
    page: 'Hosting',
    text: 'The switch that makes this computer a host, and internet streaming without forwarding a port.',
    img: hosting,
    alt: 'Helio’s Hosting settings: the switch that turns hosting on, what the system must allow, and the host’s name and network.',
  },
  {
    page: 'Agent setup',
    text: 'Which model your agents use, and what they may do on this host.',
    img: agents,
    alt: 'Helio’s Agent setup page: the provider and model an agent session uses, and what agents may do on this host.',
  },
];
---

<section class="section" id="apps">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">The app</span>
      <h2 class="title">One native app, on every computer</h2>
      <p class="lede">
        The client on every computer you sit at and, with hosting on, the host too. A native GPUI window that follows
        your light or dark appearance and explains every setting in a line.
      </p>
    </div>

    <div class="gallery" data-gallery>
      <div class="tabs" role="group" aria-label="Pages of the app">
        {tabs.map((t, i) => (
          <button
            type="button"
            class="tab"
            id={`tab-${i}`}
            aria-controls={`pane-${i}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-tab={i}
          >
            {t.page}
          </button>
        ))}
      </div>

      <div class="panes">
        {tabs.map((t, i) => (
          <div
            class="pane"
            role="region"
            id={`pane-${i}`}
            aria-labelledby={`tab-${i}`}
            data-pane={i}
            data-on={i === 0 ? '' : undefined}
          >
            <figure class="capture">
              <figcaption>{t.text}</figcaption>
              <Image src={t.img} alt={t.alt} widths={[640, 960, 1280, 1880]} sizes="(max-width: 1168px) 94vw, 1120px" />
            </figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .gallery:not([data-ready]) .tabs {
    display: none;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 36px;
    padding: 7px 14px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    isolation: isolate;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }

  .tab:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.3);
  }

  .tab[aria-pressed='true'] {
    border-color: rgb(255 255 255 / 0.5);
    background: var(--surface-2);
    color: var(--text);
  }

  /* While the pages change by themselves, the chosen tab fills from left to
     right in the time it has left. A new tab starts its fill afresh; it
     holds while the gallery is off screen. */
  .tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--accent-rgb) / 0.28);
    transform: scaleX(0);
    transform-origin: left;
  }

  .gallery[data-auto] .tab[aria-pressed='true']::before {
    animation: fill var(--dwell) linear forwards;
  }

  .gallery[data-auto][data-away] .tab[aria-pressed='true']::before {
    animation-play-state: paused;
  }

  @keyframes fill {
    to {
      transform: none;
    }
  }

  /* Every page in the same cell, so the gallery keeps the tallest one's
     height and nothing below it moves when the page changes. */
  .panes {
    display: grid;
    margin-top: 24px;
  }

  /* The new page is there at once, its words with it; only the old
     picture fades away, above the new one. */
  .pane {
    z-index: 1;
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0s linear 0.25s;
  }

  .pane:not([data-on]) figcaption {
    visibility: hidden;
  }

  .pane[data-on] {
    z-index: 0;
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .gallery:not([data-ready]) .panes {
    display: block;
  }

  .gallery:not([data-ready]) .pane {
    margin-top: 24px;
    opacity: 1;
    visibility: visible;
  }

  .gallery:not([data-ready]) .pane figcaption {
    visibility: visible;
  }

  figcaption {
    max-width: var(--measure);
    margin-bottom: 24px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pane {
      transition: none;
    }
  }
</style>

<script>
  /** How long each page shows before the next. */
  const DWELL = 6000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    let current = 0;
    root.style.setProperty('--dwell', `${DWELL}ms`);

    const show = (i: number) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        t.setAttribute('aria-pressed', String(j === current));
      });
      panes.forEach((p, j) => {
        p.toggleAttribute('data-on', j === current);
        p.setAttribute('aria-hidden', String(j !== current));
      });
    };

    const auto = (on: boolean) => root.toggleAttribute('data-auto', on);

    // On by themselves unless the reader asked for less motion. Reaching a
    // page's button stops them for good, by pointer or by keyboard, which is
    // how the reader takes over: nothing moves under them after that.
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    auto(!still.matches);
    still.addEventListener('change', (e) => e.matches && auto(false));
    root.addEventListener('focusin', () => auto(false));

    // The fill running out is the cue for the next page.
    root.addEventListener('animationend', (e) => {
      if (e.animationName === 'fill' && root.hasAttribute('data-auto')) show(current + 1);
    });

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        auto(false);
        show(i);
      }),
    );

    // Every page's picture is fetched and decoded as the gallery comes near,
    // so none appears late the first time it is shown. Off screen, the
    // fill holds.
    let fetched = false;
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !fetched) {
          fetched = true;
          for (const img of root.querySelectorAll('img')) {
            img.loading = 'eager';
            img.decode().catch(() => {});
          }
        }
      },
      { rootMargin: '800px 0px' },
    ).observe(root);
    new IntersectionObserver(([e]) => root.toggleAttribute('data-away', !e.isIntersecting)).observe(root);
    show(0);
    root.dataset.ready = '';
  }
</script>
