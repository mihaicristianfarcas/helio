---
// The app's icon as a rounded square, and the name. assets/helio.svg and
// public/favicon.svg are the same picture, drawn by make-icon
// (helio-app/examples/make-icon.rs) from helio-app/assets/icon.svg.
import icon from '../assets/helio.svg';

interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span class="logo">
  <img src={icon.src} width={size} height={size} alt="" />
  <span class="name">Helio</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .name {
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
</style>
