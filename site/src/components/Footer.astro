---
//! Project and documentation navigation, including the on-page FAQ.
import Logo from './Logo.astro';
import { DISCUSSIONS, REPO, onGitHub } from '../lib/repo';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = Astro.url.pathname.replace(/\/?$/, '/') === base ? '' : base;
---

<footer class="footer">
  <div class="wrap columns">
    <div class="about">
      <Logo />
      <p>
        Helio follows the lead of <a href="https://moonlight-stream.org">Moonlight</a> and
        <a href="https://github.com/LizardByte/Sunshine">Sunshine</a>/<a href="https://github.com/ClassicOldSong/Apollo">Apollo</a>:
        where it had to choose how streaming should behave, it chose what they do, and its virtual displays follow
        Apollo, the Sunshine fork that made them. It is a separate
        implementation, written from scratch in Rust. The tunnel is
        <a href="https://github.com/mihaicristianfarcas/pq-boringtun">pq-boringtun</a>; the windows are drawn with
        <a href="https://github.com/zed-industries/zed/tree/main/crates/gpui">GPUI</a>.
      </p>
    </div>
    <div class="links">
      <nav aria-label="Documentation">
        <h2>Documentation</h2>
        <a href={onGitHub('docs/install.md')}>Installing</a>
        <a href={onGitHub('docs/usage.md')}>Using Helio</a>
        <a href={onGitHub('docs/networking.md')}>Reaching a host from anywhere</a>
        <a href={`${base}agents/`}>AI agents</a>
        <a href={onGitHub('docs/benchmarks.md')}>Benchmarks</a>
        <a href={`${home}#faq`}>Frequently asked questions</a>
      </nav>
      <nav aria-label="Project">
        <h2>Project</h2>
        <a href={REPO}>Source</a>
        <a href={`${REPO}/releases`}>Releases</a>
        <a href={DISCUSSIONS}>Discussions</a>
        <a href={onGitHub('CONTRIBUTING.md')}>Contributing</a>
        <a href={onGitHub('SECURITY.md')}>Security</a>
        <a href={onGitHub('LICENSE')}>GPL-3.0 License</a>
      </nav>
    </div>
  </div>
  <div class="wrap legal">
    <span>Licensed under the GPL-3.0.</span>
    <span>Moonlight, Sunshine and Apollo are their authors’ projects; Helio is not affiliated with them.</span>
  </div>
</footer>

<style>
  .footer {
    padding-top: 56px;
    border-top: 1px solid var(--line);
  }

  /* Two blocks held to the two edges, so the gap between them says they are
     two: the links' right edge is the legal line's. */
  .columns {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .about {
    max-width: 30rem;
  }

  .links {
    display: flex;
    flex: none;
    gap: 72px;
  }

  .about p {
    margin-top: 16px;
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    font-size: 0.875rem;
  }

  nav a {
    padding-block: 4px;
    color: var(--text-2);
  }

  nav a:hover {
    color: var(--text);
  }

  h2 {
    margin-bottom: 4px;
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-block: 24px 32px;
    color: var(--text-3);
    font-size: 0.8125rem;
  }

  @media (max-width: 860px) {
    .columns {
      flex-direction: column;
    }

    .about {
      max-width: none;
    }

    .links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>
