---
//! The license, what Helio is and the way to the downloads, with what a
//! stream can be along the bottom. The pictures are one window on macOS's and
//! Windows' default wallpapers, as each desktop composites it
//! (scripts/capture-hero.sh). The version is the install card's
//! to say, from the downloads' own latest.json.
import PageHero from './PageHero.astro';
import Specs from './Specs.astro';
import { REPO, onGitHub } from '../lib/repo';
import macos from '../assets/hero/macos.webp';
import windows from '../assets/hero/windows.webp';

const alt = (desktop: string) =>
  `Helio on ${desktop}, on its default wallpaper: the Hosts page with three paired hosts, two online, and one more found on the network.`;
---

<!-- The best-tested setup: the Mac, the client, in front of the Windows host. -->
<PageHero
  id="top"
  badge={{ text: 'GPL-3.0', href: onGitHub('LICENSE') }}
  title="Low-latency remote desktop and game streaming"
  actions={[
    { label: 'Download', href: '#install', primary: true },
    { label: 'View on GitHub', href: REPO },
  ]}
  shots={[
    { src: windows, alt: alt('Windows 11'), place: 'back' },
    { src: macos, alt: alt('macOS'), place: 'front' },
  ]}
>
  Stream a computer’s desktop and games to another, inside one post-quantum WireGuard tunnel. One app for macOS, Windows
  and Linux, with hosting a switch you turn on. Free and open source.
  <Specs slot="foot" />
</PageHero>
