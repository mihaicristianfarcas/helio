---
//! The page's opening, as zeron.sh opens its own: what Helio is, one
//! sentence, the downloads (Install.astro) and the repository; then a real
//! stream (scripts/capture-hero.sh): Helio's window on a MacBook, the
//! client, in front of the host's Overview of that same session on a Windows
//! PC's monitor. The screens are pictures, menu bar, Dock and taskbar
//! included (scripts/hero/screens.html); the two devices are drawn here.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SystemMark from './SystemMark.astro';
import stream from '../assets/hero/stream.webp';
import host from '../assets/hero/host.webp';
import { REPO } from '../lib/repo';
import { short, stars } from '../lib/stars';

const count = await stars();
const hostAlt =
  'Helio on the host, gaming-pc, a Windows PC: This computer → Overview, streaming to macbook at 2240 × 1480, 120 fps in HEVC, 93 frames a second sent, a host latency of 10.9 ms.';
const streamAlt =
  'Helio on a MacBook, streaming gaming-pc in a window: the PC’s screen as its monitor shows it, Helio’s Overview above the Windows taskbar, with the stream’s statistics over it.';
---

<section class="hero" id="top">
  <div class="wrap">
    <h1>
      <span class="phrase">Low-latency remote desktop</span>
      <span class="phrase">and game streaming</span>
    </h1>
    <p class="lead">
      Stream a computer’s desktop and games to another, inside one post-quantum WireGuard tunnel. One app for macOS,
      Windows and Linux, free and open source.
    </p>
    <div class="actions">
      <a class="button primary" href="#install">
        <span class="mark">
          <Icon name="download" size={17} />
          <SystemMark system="macos" />
          <SystemMark system="windows" />
          <SystemMark system="linux" />
        </span>
        <span
          >Download<span data-for="macos"> for macOS</span><span data-for="windows"> for Windows</span><span
            data-for="linux"> for Linux</span
          ></span
        >
      </a>
      <a class="star" href={REPO}>
        Star on GitHub
        {count !== null && <span class="num" data-count>{short(count)}</span>}
        <Icon name="chevron-right" size={12} />
      </a>
    </div>
  </div>
  <div class="wrap stage">
    <div class="pair">
      <figure class="monitor">
        <div class="panel">
          <Image
            src={host}
            alt={hostAlt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(max-width: 1248px) 64vw, 797px"
            loading="eager"
          />
        </div>
      </figure>
      <figure class="macbook">
        <div class="lid">
          <div class="bezel">
            <Image
              src={stream}
              alt={streamAlt}
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="(max-width: 1248px) 53vw, 655px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <span class="base"></span>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    padding-top: clamp(48px, 10vh, 128px);
  }

  h1 {
    font-size: min(var(--hero-size), 7.5vh);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  /* The title breaks between its phrases, not inside them. */
  .phrase {
    display: inline-block;
  }

  .lead {
    max-width: 52rem;
    margin-top: min(28px, 3vh);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: min(40px, 4.5vh);
  }

  /* The visitor's system's mark and name (layouts/Base.astro, before the
     first paint), or the download arrow and Download alone where there is
     none. */
  .mark {
    display: flex;
  }

  .mark > :global(svg),
  [data-for] {
    display: none;
  }

  :global(:root[data-os='macos']) [data-for='macos'],
  :global(:root[data-os='windows']) [data-for='windows'],
  :global(:root[data-os='linux']) [data-for='linux'] {
    display: inline;
  }

  :global(:root:not([data-os])) .mark > :global(svg:first-child),
  :global(:root[data-os='macos']) .mark > :global([data-mark='macos']),
  :global(:root[data-os='windows']) .mark > :global([data-mark='windows']),
  :global(:root[data-os='linux']) .mark > :global([data-mark='linux']) {
    display: block;
  }

  .star {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .star:hover {
    color: var(--text);
  }

  .stage {
    display: grid;
    justify-items: end;
    padding-top: clamp(32px, 5vh, 64px);
  }

  /* The PC's monitor behind, up and to the right; the MacBook in front of
     it, lower and to the left. Every size is a share of the pair's width
     (cqw), so it keeps its shape at every width, 61.5 of 100 tall: the
     MacBook's top 19.5 below the monitor's, just under the session's
     figures on the monitor (their card ends at 18.2). The first screen shows the text and the
     monitor's top; the rest follows, whole, as the page scrolls. */
  .pair {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 61.5;
  }

  .pair > figure {
    position: absolute;
    margin: 0;
  }

  .pair :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* To look at only: not dragged, selected or opened on their own. */
    pointer-events: none;
  }

  /* A plain monitor's panel: thin black bezels and a deeper chin, round a
     screen of the stream's 2240:1480. */
  .monitor {
    top: 0;
    right: 0;
    width: 68cqw;
  }

  .panel {
    position: relative;
    z-index: 1;
    padding: 0.8cqw 0.8cqw 2cqw;
    border-radius: 1cqw;
    background: #0d0d0f;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 2cqw 4cqw rgb(0 0 0 / 0.35);
  }

  .panel :global(img) {
    border-radius: 0.2cqw;
  }

  /* A space black MacBook Pro from the front: the lid's rim round a black
     bezel, the display's top corners round, the base a little wider than
     the lid, with the scoop for a thumb in its edge, on its two front feet.
     The notch is in the picture, against the menu bar. */
  .macbook {
    z-index: 1;
    left: 0;
    bottom: 0.35cqw;
    width: 62cqw;
  }

  .macbook::before,
  .macbook::after {
    content: '';
    position: absolute;
    bottom: -0.35cqw;
    width: 4.5cqw;
    height: 0.35cqw;
    border-radius: 0 0 0.3cqw 0.3cqw;
    background: #0b0b0c;
  }

  .macbook::before {
    left: 5%;
  }

  .macbook::after {
    right: 5%;
  }

  .lid {
    width: 57.4cqw;
    margin: 0 auto;
    padding: 0.3cqw 0.3cqw 0;
    border-radius: 2.3cqw 2.3cqw 0 0;
    background: linear-gradient(#45474c, #26272a);
  }

  .bezel {
    padding: 1.1cqw 1.1cqw 1.9cqw;
    border-radius: 2cqw 2cqw 0 0;
    background: #000;
  }

  .bezel :global(img) {
    border-radius: 0.9cqw 0.9cqw 0 0;
  }

  .base {
    position: relative;
    display: block;
    height: 1.6cqw;
    border-radius: 0 0 1.6cqw 1.6cqw / 0 0 1.2cqw 1.2cqw;
    background: linear-gradient(#55575c, #333438 40%, #1c1d20);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22);
  }

  .base::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 9cqw;
    height: 0.6cqw;
    transform: translateX(-50%);
    border-radius: 0 0 0.7cqw 0.7cqw;
    background: linear-gradient(#17181a, #2e2f33);
  }

  /* The MacBook stands in its own soft shadow. */
  .base::after {
    content: '';
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: -1.75cqw;
    height: 2.4cqw;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.5), transparent);
  }
</style>
