---
//! The canvas behind the page, which lib/sky.js draws the sky on: fixed to the
//! window, so every part of the page sits on the same sky. The large viewport
//! height, so a phone's collapsing toolbar is not a new size to draw.
---

<canvas class="sky" data-sky aria-hidden="true"></canvas>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100lvh;
    pointer-events: none;
  }
</style>

<script>
  import '../lib/sky.js';
</script>
