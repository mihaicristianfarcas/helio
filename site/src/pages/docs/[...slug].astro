---
//! A documentation page: one of the repository's Markdown files
//! (lib/docs.mjs), with every page beside it and this page's sections. On
//! a narrow screen the list of pages folds into a button above the text.
//! The search (Search.astro) opens from the field above the list of pages,
//! and on a narrow screen from the same field above that button.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import Search from '../../components/Search.astro';
import SearchButton from '../../components/SearchButton.astro';
import { GROUPS, PAGES, hrefOf } from '../../lib/docs.mjs';
import { onGitHub } from '../../lib/repo';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const slug = entry.id === 'index' ? '' : entry.id;
const at = PAGES.findIndex((p) => p.slug === slug);
const page = PAGES[at];
const previous = PAGES[at - 1];
const next = PAGES[at + 1];

const heading = headings.find((h) => h.depth === 1)?.text ?? page.title;
const sections = headings.filter((h) => h.depth === 2);
// The page's first paragraph, as plain text, says what it is to a search
// engine or a link preview.
const lead = (entry.body ?? '')
  .split(/\n\s*\n/)
  .map((block) => block.trim())
  .find((block) => block && !/^(#|!\[|\||```|- |\d+\. |>|<)/.test(block));
const plain = (lead ?? heading)
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[*_`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const description = plain.length > 160 ? `${plain.slice(0, 157).replace(/\s+\S*$/, '')}…` : plain;
const title = slug ? `${heading} · Helio documentation` : 'Helio documentation';
---

<Base title={title} description={description}>
  <Nav />
  <div class="wrap docs">
    <div class="search-narrow"><SearchButton /></div>
    <details class="pages-narrow">
      <summary>Documentation <span aria-hidden="true">›</span> <strong>{page.title}</strong></summary>
      <nav aria-label="Documentation">
        {
          GROUPS.map((group) => (
            <div class="group">
              <p class="group-name">{group.name}</p>
              {group.pages.map((p) => (
                <a href={hrefOf(base, p.slug)} aria-current={p.slug === slug ? 'page' : undefined}>
                  {p.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </details>

    <aside class="pages">
      <div class="search-wide"><SearchButton /></div>
      <nav aria-label="Documentation">
        {
          GROUPS.map((group) => (
            <div class="group">
              <p class="group-name">{group.name}</p>
              {group.pages.map((p) => (
                <a href={hrefOf(base, p.slug)} aria-current={p.slug === slug ? 'page' : undefined}>
                  {p.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </aside>

    <main id="main" class="doc">
      <article class="prose" data-pagefind-body>
        <Content />
      </article>
      <footer class="doc-foot">
        <a class="edit" href={onGitHub(page.file)}>Edit this page on GitHub</a>
        <div class="turns">
          {
            previous && (
              <a class="turn" href={hrefOf(base, previous.slug)} rel="prev">
                <span>Previous</span>
                {previous.title}
              </a>
            )
          }
          {
            next && (
              <a class="turn next" href={hrefOf(base, next.slug)} rel="next">
                <span>Next</span>
                {next.title}
              </a>
            )
          }
        </div>
      </footer>
    </main>

    {
      sections.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="group-name">On this page</p>
          {sections.map((h) => (
            <a href={`#${h.slug}`} data-section={h.slug}>
              {h.text}
            </a>
          ))}
        </nav>
      )
    }
  </div>
  <Footer />
  <Search />
</Base>

<script>
  // "On this page" marks the section being read: the last one whose heading
  // has passed under the header (the first, above them all), or the last
  // one when the page has reached its end. It follows the page's scroll events, a frame at a time.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc [data-section]')];
  const headings = links
    .map((link) => document.getElementById(link.dataset.section!))
    .filter((heading): heading is HTMLElement => heading !== null);
  if (links.length > 0) {
    let pending = false;
    const mark = () => {
      pending = false;
      const nav = document.querySelector<HTMLElement>('[data-nav]')?.offsetHeight ?? 64;
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let current = 0;
      headings.forEach((heading, i) => {
        if (heading.getBoundingClientRect().top <= nav + 96) current = i;
      });
      if (atEnd) current = headings.length - 1;
      links.forEach((link, i) => {
        if (i === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const ask = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(mark);
    };
    window.addEventListener('scroll', ask, { passive: true });
    window.addEventListener('resize', ask, { passive: true });
    mark();
  }
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 13rem;
    gap: 56px;
    align-items: start;
    padding-block: 48px clamp(64px, 8vw, 112px);
  }

  .group-name {
    margin-bottom: 8px;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* The list of pages and the sections stay in view beside the text,
     held where they start (the header, then .docs' 48 px): stuck any
     higher, they would slide up with the first scroll before stopping. */
  .pages,
  .toc {
    position: sticky;
    top: calc(var(--nav-height, var(--nav)) + 48px);
    max-height: calc(100vh - var(--nav-height, var(--nav)) - 72px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .pages nav,
  .pages-narrow nav {
    display: grid;
    gap: 28px;
  }

  .group {
    display: grid;
  }

  .group a,
  .toc a {
    padding-block: 5px;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .group a:hover,
  .toc a:hover {
    color: var(--text);
  }

  .group a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
  }

  .toc {
    display: grid;
  }

  .toc a {
    padding-left: 12px;
    border-left: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  /* The section being read (the script above). */
  .toc a[aria-current] {
    border-left-color: var(--sky-2);
    color: var(--text);
  }

  .pages-narrow,
  .search-narrow {
    display: none;
  }

  .search-wide {
    margin-bottom: 28px;
  }

  .doc {
    min-width: 0;
  }

  .doc-foot {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .edit {
    color: var(--text-2);
    font-size: 0.875rem;
  }

  .edit:hover {
    color: var(--text);
  }

  .turns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .turn {
    display: grid;
    gap: 2px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-weight: 500;
  }

  .turn:hover {
    border-color: var(--line-2);
  }

  .turn span {
    color: var(--text-3);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .turn.next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 13rem minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }

    .pages {
      display: none;
    }

    /* The field and the list of pages under it, closer than the text. */
    .search-narrow {
      display: block;
      margin-bottom: -12px;
    }

    .pages-narrow {
      display: block;
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .pages-narrow summary {
      padding: 12px 16px;
      color: var(--text-2);
      font-size: 0.9rem;
      cursor: pointer;
    }

    .pages-narrow strong {
      color: var(--text);
      font-weight: 500;
    }

    .pages-narrow nav {
      padding: 4px 16px 16px;
    }
  }

  /* The repository's Markdown, in the page's type. */
  .prose {
    max-width: 46rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(h1) {
    margin-bottom: 24px;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .prose :global(h2) {
    margin: 56px 0 16px;
    padding-top: 8px;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    margin: 36px 0 12px;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .prose :global(h4) {
    margin: 28px 0 8px;
    font-size: 1rem;
  }

  .prose :global(:is(p, ul, ol, table, pre, blockquote, img)) {
    margin: 0 0 18px;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(li > :is(ul, ol)) {
    margin: 6px 0 0;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--card-2);
    color: var(--text);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--text);
    font-size: 0.85rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(blockquote) {
    padding-left: 16px;
    border-left: 2px solid var(--sky-5);
  }

  .prose :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(img) {
    height: auto;
    border-radius: 10px;
  }

  /* Wide tables scroll on their own rather than widen the page. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .prose :global(:is(th, td)) {
    padding: 9px 14px 9px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
  }
</style>
