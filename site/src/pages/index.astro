---
//! The landing page: what Helio is, how fast it is against Moonlight, what
//! the one app does, how it keeps a stream private, AI agents, and the
//! downloads. Only what matters most is here; the rest is in the
//! documentation (pages/docs), which the repository's own docs make.
import Base from '../layouts/Base.astro';
import Agents from '../components/Agents.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Install from '../components/Install.astro';
import Latency from '../components/Latency.astro';
import Nav from '../components/Nav.astro';
import OneApp from '../components/OneApp.astro';
import Private from '../components/Private.astro';
import { onGitHub } from '../lib/repo';

const title = 'Helio: Open-source remote desktop & game streaming';
const description =
  'Free, open-source remote desktop and game streaming for macOS, Windows and Linux, as fast as Moonlight, in a post-quantum WireGuard tunnel.';
const canonical = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical.href}#website`,
      name: 'Helio',
      url: canonical.href,
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonical.href}#software`,
      name: 'Helio',
      url: canonical.href,
      description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS 14 or later, Windows 10 or 11, Linux',
      license: onGitHub('LICENSE'),
      downloadUrl: `${canonical.href}#install`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<Base title={title} description={description} structuredData={structuredData} jumps>
  <Nav landing />
  <main id="main">
    <Hero />
    <Latency />
    <OneApp />
    <Private />
    <Agents />
    <Install />
  </main>
  <Footer />
</Base>
