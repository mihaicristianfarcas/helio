<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The host, as a helper inside Ping.app (Contents/Helpers/Pong Host.app,
	     tools/build-ping-app). System Settings lists it by this name. -->
	<key>CFBundleName</key>
	<string>Pong Host</string>
	<key>CFBundleDisplayName</key>
	<string>Pong Host</string>
	<!-- Screen Recording, Accessibility and System Audio Recording are
	     granted to this identity, not to Ping's (dev.pingpong.Ping), so the
	     app never needs them, and they follow the host rather than whichever
	     terminal started it. -->
	<key>CFBundleIdentifier</key>
	<string>dev.pingpong.Pong</string>
	<key>CFBundleExecutable</key>
	<string>pong</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both versions are set to the workspace's by tools/build-ping-app. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<!-- The Privacy & Security lists and Login Items show it. -->
	<key>CFBundleIconFile</key>
	<string>Pong</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Mihai-Cristian Farcaș. GPL-3.0 License.</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- A background host: no Dock icon, no menu bar (Ping shows its icon). -->
	<key>LSUIElement</key>
	<true/>
	<!-- Asked the first time a client wants sound in surround: a Core
	     Audio tap of the output device (pong/src/mac/sound.rs). -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>While hosting is on in Ping, Pong Host streams this Mac's sound in surround to the device you stream to.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>While hosting is on in Ping, Pong Host streams this Mac to the devices you pair with it on your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pingpong._udp</string>
	</array>
</dict>
</plist>
