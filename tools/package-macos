#!/usr/bin/env bash
# Package Helio for macOS as a release: the app, with the host inside it
# (Contents/Helpers/Helio Host.app), built as one (HELIO_RELEASE=1: it then
# follows releases, not the main branch), in a zip archive for a GitHub
# release, the website's downloads and the Homebrew cask.
#
#   tools/package-macos               build, sign, notarize and archive:
#     -> target/dist/Helio-VERSION-macos-ARCH.zip  (Helio.app)
#   tools/package-macos --stage-only  only build:
#     -> target/stage/Helio.app.zip
#   tools/package-macos --from ZIP    only sign, notarize and archive the
#                                     app in ZIP, which --stage-only made;
#                                     no cargo and no build script runs
#
# ARCH is the app's (arm64 or x86_64), VERSION the workspace's. The release
# workflow (.github/workflows/release.yml) builds with --stage-only on one Mac
# of each, then signs and archives with --from on another runner, the only
# one that holds the Developer ID; then tools/update-casks. --stage-only zips
# with ditto, which keeps what an artifact's upload would not: the link to
# the command line, and the programs' modes.
#
# The build is signed as a development build is (tools/sign-helio-app,
# without HELIO_SIGN_IDENTITY). Archiving signs it again, inside out, with
# the Developer ID that HELIO_SIGN_IDENTITY names, if set. With an App Store
# Connect API key (APPLE_API_KEY_PATH, the .p8 file; APPLE_API_KEY_ID;
# APPLE_API_ISSUER) it is notarized by Apple, helper and all in one
# submission, and the ticket is stapled to the app, so macOS opens it from a
# download, offline too. The release workflow sets all four on main.
# HELIO_PROFILE=dev packages a debug build (CI checks the packaging so).
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
VERSION=$(sed -n '/^\[workspace.package\]/,/^\[/ s/^version = "\(.*\)"/\1/p' "$REPO/Cargo.toml")
DIST="$REPO/target/dist"
APP="$REPO/target/Helio.app"
STAGED="$REPO/target/stage/Helio.app.zip"

MODE=all
case ${1:-} in
    "") ;;
    --stage-only) MODE=stage ;;
    --from)
        MODE=package
        FROM=${2:?"--from needs the zip that --stage-only made"}
        ;;
    *)
        echo "usage: tools/package-macos [--stage-only | --from ZIP]" >&2
        exit 2
        ;;
esac

if [[ $MODE != stage && -n ${APPLE_API_KEY_PATH:-} && -z ${HELIO_SIGN_IDENTITY:-} ]]; then
    echo "notarization needs a Developer ID to sign with: set HELIO_SIGN_IDENTITY" >&2
    exit 1
fi

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

if [[ $MODE == package ]]; then
    ditto -x -k "$FROM" "$STAGE/app"
    APP="$STAGE/app/Helio.app"
    if [[ ! -d $APP ]]; then
        echo "$FROM holds no Helio.app" >&2
        exit 1
    fi
else
    # The Developer ID is the archiving's, never the build's.
    HELIO_SIGN_IDENTITY='' HELIO_RELEASE=1 "$REPO/tools/build-helio-app"
    if [[ $MODE == stage ]]; then
        mkdir -p "$(dirname "$STAGED")"
        rm -f "$STAGED"
        ditto -c -k --keepParent "$APP" "$STAGED"
        echo "staged $STAGED"
        exit 0
    fi
fi

# The architecture the app was built for, not this Mac's: the release
# archives both on Apple silicon.
ARCH=$(lipo -archs "$APP/Contents/MacOS/Helio")
if [[ $ARCH != arm64 && $ARCH != x86_64 ]]; then
    echo "Helio.app is built for \"$ARCH\", not for one of arm64 and x86_64" >&2
    exit 1
fi

if [[ -n ${HELIO_SIGN_IDENTITY:-} ]]; then
    "$REPO/tools/sign-helio-app" "$APP"
else
    # The build's own signature, still whole after the trip through a zip.
    codesign --verify --deep --strict "$APP"
fi

if [[ -n ${APPLE_API_KEY_PATH:-} ]]; then
    NOTARY=(--key "$APPLE_API_KEY_PATH" --key-id "${APPLE_API_KEY_ID:?}" --issuer "${APPLE_API_ISSUER:?}")
    # The app, the helper inside it: one submission, one wait for Apple,
    # minutes at most. Apple notarizes every signature in it.
    ditto -c -k --keepParent "$APP" "$STAGE/notarize.zip"
    result=$(xcrun notarytool submit "$STAGE/notarize.zip" "${NOTARY[@]}" --wait --timeout 1h --output-format json)
    status=$(plutil -extract status raw -o - - <<< "$result")
    if [[ $status != Accepted ]]; then
        # Apple's reasons, file by file.
        xcrun notarytool log "$(plutil -extract id raw -o - - <<< "$result")" "${NOTARY[@]}" >&2 || true
        echo "notarization: $status" >&2
        exit 1
    fi
    # The ticket on the app: Gatekeeper judges the helper, launched by the
    # host's LaunchAgent, by the app it is inside. stapler fetches the
    # ticket from Apple's servers, which a runner sometimes cannot reach
    # (exit 68, EX_NOHOST) right after the submission was accepted: ask
    # again, waiting longer each time.
    for attempt in 1 2 3 4 5; do
        xcrun stapler staple "$APP" && break
        if ((attempt == 5)); then
            echo "stapler: no ticket for $APP after $attempt attempts" >&2
            exit 1
        fi
        sleep $((attempt * 15))
    done
    # What Gatekeeper will say of the download: "Notarized Developer ID",
    # for the app and the helper.
    spctl --assess --type execute -vv "$APP"
    spctl --assess --type execute -vv "$APP/Contents/Helpers/Helio Host.app"
fi

mkdir -p "$DIST"
# ditto keeps what a zip from the Finder keeps (extended attributes, the
# signature's resources) so the bundle unpacks signed as it was.
ZIP="$DIST/Helio-$VERSION-macos-$ARCH.zip"
rm -f "$DIST"/*-macos-"$ARCH".zip
ditto -c -k --keepParent "$APP" "$ZIP"
echo "$(shasum -a 256 "$ZIP" | cut -d' ' -f1)  $(basename "$ZIP")"
