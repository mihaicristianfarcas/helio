#!/usr/bin/env bash
# Write the Homebrew cask (Casks/ping.rb) for a release, from the archives
# tools/package-macos made: the version, and each archive's SHA-256. This
# repository is its own tap:
#
#   brew tap mihaicristianfarcas/pingpong https://github.com/mihaicristianfarcas/pingpong
#   brew install --cask ping
#
#   tools/update-casks VERSION DIST_DIR [BASE_URL]
#
# DIST_DIR holds Ping-VERSION-macos-ARCH.zip for arm64, x86_64 or both. One
# cask installs everything: the app, and inside it the host it runs while
# hosting is on (Contents/Helpers/Pong Host.app). BASE_URL is where the
# archives are downloaded from (the release's, by default; a file:// one to
# try the cask locally). The release workflow runs this after publishing
# the release, and opens a pull request with the result.
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
VERSION=${1:?usage: update-casks VERSION DIST_DIR [BASE_URL]}
DIST=${2:?usage: update-casks VERSION DIST_DIR [BASE_URL]}
HOMEPAGE=https://github.com/mihaicristianfarcas/pingpong
BASE=${3:-"$HOMEPAGE/releases/download/v#{version}"}
OUT=${CASKS_DIR:-$REPO/Casks}

sha() {
    local zip="$DIST/Ping-$VERSION-macos-$1.zip"
    [[ -f $zip ]] && shasum -a 256 "$zip" | cut -d' ' -f1
}
ARM=$(sha arm64 || true)
INTEL=$(sha x86_64 || true)

# The version, checksums and download: one archive per architecture when
# both are there, else the one there is and a Mac of its kind required.
if [[ -n $ARM && -n $INTEL ]]; then
    DOWNLOAD=$(
        cat <<CASK
  arch arm: "arm64", intel: "x86_64"

  version "$VERSION"
  sha256 arm:   "$ARM",
         intel: "$INTEL"

  url "$BASE/Ping-#{version}-macos-#{arch}.zip"
CASK
    )
    LIMIT=
elif [[ -n $ARM || -n $INTEL ]]; then
    ONLY=arm64 SUM=$ARM LIMIT='  depends_on arch: :arm64'
    [[ -z $ARM ]] && ONLY=x86_64 SUM=$INTEL LIMIT='  depends_on arch: :x86_64'
    DOWNLOAD=$(
        cat <<CASK
  version "$VERSION"
  sha256 "$SUM"

  url "$BASE/Ping-#{version}-macos-$ONLY.zip"
CASK
    )
else
    echo "no Ping archive for $VERSION in $DIST" >&2
    exit 1
fi

mkdir -p "$OUT"
# Homebrew upgrades a cask by uninstalling the old version and installing
# the new one, and tells neither step which it is doing; its install steps
# run in a sandbox with a home folder of its own (Homebrew 7: postflight is
# deprecated, and postflight_steps cannot reach ~/Library). So the cask does
# nothing to the host, and the host follows its app itself
# (pong/src/hosting/mac.rs): replaced by an upgrade (which keeps the app
# folder and replaces what is in it), it checks the new app's helper is
# signed as it is and that Gatekeeper accepts the app, copies the helper and
# restarts on it; gone after an uninstall, it turns hosting off 15 s later.
# The uninstall quits the app (and an upgrade opens it again). zap, which
# only an explicit brew uninstall --zap runs, stops the host at once and
# removes the rest: the host's LaunchAgent and the app's own (which opens it
# at login, pingpong-ui's login.rs), the app's data and logs, the host's
# identity, pairings, logs and copy.
cat > "$OUT/ping.rb" <<CASK
# Written by tools/update-casks for each release: change that script, not
# this file.
cask "ping" do
$DOWNLOAD
  name "Ping"
  desc "Desktop and game streaming, client and host, post-quantum encrypted"
  homepage "$HOMEPAGE"

  livecheck do
    url :url
    strategy :github_latest
  end

$LIMIT
  depends_on macos: :sonoma

  app "Ping.app"

  uninstall quit: "dev.pingpong.Ping"

  zap launchctl: "dev.pingpong.Pong",
      trash:     [
        "~/Library/Application Support/Ping",
        "~/Library/Application Support/Pong",
        "~/Library/LaunchAgents/dev.pingpong.Ping.plist",
        "~/Library/LaunchAgents/dev.pingpong.Pong.plist",
        "~/Library/Logs/Ping",
        "~/Library/Preferences/dev.pingpong.Ping.plist",
      ]

  caveats <<~EOS
    Hosting is off until you turn it on in Ping (Settings > Hosting). macOS
    then asks for Screen Recording and Accessibility for Pong Host, the host
    inside Ping.
  EOS
end
CASK
# An empty line where no architecture limit applies is one too many.
awk 'NF || !blank { print } { blank = !NF }' "$OUT/ping.rb" > "$OUT/ping.rb.tmp"
mv "$OUT/ping.rb.tmp" "$OUT/ping.rb"
echo "wrote $OUT/ping.rb for $VERSION"
