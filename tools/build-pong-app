#!/usr/bin/env bash
# Build Pong.app: the macOS host, bundled so that macOS grants Screen
# Recording and Accessibility to Pong itself (signed as tools/build-ping-app
# signs Ping.app). Ping's hosting switch runs the pong inside it.
#
#   tools/build-pong-app            -> target/Pong.app
#   tools/build-pong-app --install  -> also copy it to /Applications, and
#                                      start the host at login and keep it
#                                      running (its LaunchAgent)
#
# The bundles' version is the workspace's (Cargo.toml). PINGPONG_RELEASE=1
# makes them a release build, as tools/package-macos does.
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
APP="$REPO/target/Pong.app"
AGENT="$HOME/Library/LaunchAgents/dev.pingpong.Pong.plist"
VERSION=$(sed -n '/^\[workspace.package\]/,/^\[/ s/^version = "\(.*\)"/\1/p' "$REPO/Cargo.toml")

export MACOSX_DEPLOYMENT_TARGET=14.0
# Xcode's Metal compiler, when it is installed: the bundle then carries GPUI's
# shaders compiled, not their source to compile at every launch.
FEATURES=()
XCODE=/Applications/Xcode.app/Contents/Developer
if DEVELOPER_DIR=$XCODE xcrun metal --version >/dev/null 2>&1; then
    export DEVELOPER_DIR=$XCODE
    FEATURES=(--no-default-features)
fi
cargo build --release -p pong ${FEATURES[@]+"${FEATURES[@]}"} --manifest-path "$REPO/Cargo.toml"

# Pong's icon, drawn by the same code as Ping's.
ICNS="$REPO/target/Pong.icns"
MAKE_ICON="$REPO/ping-app/examples/make-icon.rs"
if [[ ! -f $ICNS || $MAKE_ICON -nt $ICNS ]]; then
    cargo run --release -q -p ping-app --example make-icon --manifest-path "$REPO/Cargo.toml" -- "$REPO/target/icon"
    iconutil -c icns "$REPO/target/icon/Pong.iconset" -o "$ICNS"
fi

# bundle DIR PLIST: an app bundle's skeleton, its Info.plist at the
# workspace's version, and the icon.
bundle() {
    rm -rf "$1"
    mkdir -p "$1/Contents/MacOS" "$1/Contents/Resources"
    cp "$2" "$1/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" \
        -c "Set :CFBundleVersion $VERSION" "$1/Contents/Info.plist"
    cp "$ICNS" "$1/Contents/Resources/Pong.icns"
}

# A Developer ID (PINGPONG_SIGN_IDENTITY, as the release workflow sets it)
# with the hardened runtime and a secure timestamp, which notarization
# requires. Else the dev identity when there is one (see
# tools/dev-signing-identity), so the Screen Recording and Accessibility
# permissions survive a rebuild; else ad hoc.
if [[ -n ${PINGPONG_SIGN_IDENTITY:-} ]]; then
    SIGN=(--sign "$PINGPONG_SIGN_IDENTITY" --options runtime --timestamp)
else
    DEV=$("$REPO/tools/dev-signing-identity" --check)
    SIGN=(--sign "${DEV:--}")
fi

bundle "$APP" "$REPO/pong/macos/Info.plist"
cp "$REPO/target/release/pong" "$APP/Contents/MacOS/pong"
codesign --force "${SIGN[@]}" --identifier dev.pingpong.Pong "$APP" >/dev/null
echo "built $APP ($VERSION)"

if [[ ${1:-} == --install ]]; then
    rm -rf /Applications/Pong.app
    cp -R "$APP" /Applications/Pong.app
    # The host: hosting on, now and at login, kept running (the LaunchAgent
    # $AGENT, which pong writes; Ping's hosting switch does the same).
    /Applications/Pong.app/Contents/MacOS/pong enable
    echo "installed /Applications/Pong.app"
    echo "the host starts at login ($AGENT)"
    echo "macOS will ask for Screen Recording and Accessibility the first time."
fi
