#!/usr/bin/env bash
# Build, test and run Helio on Linux in a container (Docker; on a Mac,
# colima). The tree is mounted at /src; the build, the crate registry and
# git dependencies (GPUI's Zed checkout) live in volumes of their own.
#
#   tools/linux-dev                      cargo build (the app and the CLI)
#   tools/linux-dev cargo test -p helio-client
#   tools/linux-dev xvfb-run -a ...      run with a virtual X display
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
docker build -q -t helio-linux "$REPO/tools/linux" >/dev/null
args=("$@")
[[ ${#args[@]} -eq 0 ]] && args=(cargo build -p helio-app -p helio-client)
exec docker run --rm ${HELIO_DOCKER_ARGS:-} \
    -v "$REPO":/src -w /src \
    -v helio-linux-target:/target -e CARGO_TARGET_DIR=/target \
    -v helio-linux-registry:/root/.cargo/registry \
    -v helio-linux-git:/root/.cargo/git \
    -e RUST_LOG \
    helio-linux "${args[@]}"
