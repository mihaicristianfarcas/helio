# The host, as a systemd user service in the desktop session it streams.
# Helio's install.sh (tools/linux/install-release) puts it in
# ~/.config/systemd/user with ExecStart naming the helio-host it installed beside
# the app, and does not enable it: hosting is off until the app's switch
# turns it on (`helio-host enable`: systemctl --user enable --now helio-host; off: helio-host
# disable).
#
# The desktop hands DISPLAY to user services (GNOME and KDE do). Logs:
# ~/.config/helio-host/logs, or `journalctl --user -u helio-host`.
[Unit]
Description=Helio Host: streams this computer to the devices paired with it
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/helio-host host
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
