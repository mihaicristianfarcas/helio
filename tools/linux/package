#!/usr/bin/env bash
# Package Helio for Linux as a release: the app and the host's engine, built
# as one (HELIO_RELEASE=1: they then follow releases, not the main
# branch), in one tar archive for a GitHub release and the website's
# downloads.
#
#   tools/linux/package
#     -> target/dist/Helio-VERSION-linux-ARCH.tar.gz
#
# The archive is a folder of the same name with the app (helio-app), the
# host's engine (helio-host) and its user unit (helio-host.service, installed but not
# enabled: hosting is off until the app's switch turns it on), the launcher
# entry and its icon, and install.sh (tools/linux/install-release). ARCH is
# this machine's (x86_64, aarch64); VERSION the workspace's. The programs
# link the system's libraries (FFmpeg, PipeWire, ...) as this machine has
# them: built on Ubuntu 24.04, they run on it and on distributions built on
# it. The release workflow (.github/workflows/release.yml) runs this on an
# Ubuntu 24.04 runner. HELIO_PROFILE=dev packages a debug build (CI
# checks the packaging so).
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
VERSION=$(sed -n '/^\[workspace.package\]/,/^\[/ s/^version = "\(.*\)"/\1/p' "$REPO/Cargo.toml")
ARCH=$(uname -m)
PROFILE=${HELIO_PROFILE:-release}
TARGET=${CARGO_TARGET_DIR:-$REPO/target}
case $PROFILE in
    dev) OUT="$TARGET/debug" ;;
    *) OUT="$TARGET/$PROFILE" ;;
esac
DIST="$REPO/target/dist"

export HELIO_RELEASE=1
cd "$REPO"
cargo build --profile "$PROFILE" -p helio-app
# The host on its own: it and the GPUI apps ask one dependency for different
# async runtimes (docs/development.md).
cargo build --profile "$PROFILE" -p helio-host

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
NAME=Helio-$VERSION-linux-$ARCH
mkdir -p "$DIST" "$STAGE/$NAME"
# FILE given as SOURCE or SOURCE:NAME_IN_ARCHIVE.
for file in \
    "$OUT/helio-app" \
    "$OUT/helio-host" \
    "$REPO/tools/linux/helio-host.service" \
    "$REPO/tools/linux/dev.mihaicristian.helio.desktop" \
    "$REPO/helio-app/assets/icon-256.png:dev.mihaicristian.helio.png" \
    "$REPO/tools/linux/install-release:install.sh"; do
    from=${file%%:*} to=${file#*:}
    [[ $file == *:* ]] || to=$(basename "$from")
    install -m "$([[ -x $from ]] && echo 755 || echo 644)" "$from" "$STAGE/$NAME/$to"
done
# Unpacked as whoever unpacks it, not as the build's user.
rm -f "$DIST"/*-linux-"$ARCH".tar.gz
tar -C "$STAGE" --owner=0 --group=0 --numeric-owner -czf "$DIST/$NAME.tar.gz" "$NAME"
echo "$(sha256sum "$DIST/$NAME.tar.gz" | cut -d' ' -f1)  $NAME.tar.gz"
