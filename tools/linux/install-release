#!/usr/bin/env bash
# Install Ping for this user from a release archive (made by
# tools/linux/package, where this script is install.sh); tools/linux/
# install-apps runs it on a checkout's build, laid out the same way:
#
# - the app (ping-app) and the host's engine (pong) in ~/.local/bin, side by
#   side, where the app's hosting switch finds the engine;
# - the launcher entry, with its icon;
# - the host's user unit (pong.service), installed but not enabled: hosting
#   is off until the app's switch turns it on (`pong enable`). An update
#   over a host that runs restarts it on the new engine; one that is off
#   stays off.
#
#   ./install.sh                # from the unpacked archive
#   ./install.sh --uninstall    # hosting off first, then all of the above
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BIN=${XDG_BIN_HOME:-$HOME/.local/bin}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
UNITS=$CONFIG/systemd/user
# The launcher entry and its icon, named after the window's app id, so the
# desktop groups the window under the entry (Wayland's app_id, X11's
# WM_CLASS).
ID=dev.pingpong.Ping

# Menus and docks pick the entry up (or drop it) without logging out.
refresh_launcher() {
    command -v update-desktop-database >/dev/null && update-desktop-database -q "$DATA/applications" || true
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t "$DATA/icons/hicolor" 2>/dev/null || true
}

if [[ ${1:-} == --uninstall ]]; then
    # Hosting off first: the host stopped, and no longer started at login.
    # A failure stops the uninstall here, with everything still in place to
    # turn it off by hand (pong disable).
    if [[ -x $BIN/pong ]]; then
        "$BIN/pong" disable
    fi
    rm -f "$UNITS/pong.service" "$BIN/pong" "$BIN/ping-app" \
        "$DATA/applications/$ID.desktop" "$DATA/icons/hicolor/256x256/apps/$ID.png"
    systemctl --user daemon-reload 2>/dev/null || true
    refresh_launcher
    echo "uninstalled; your hosts, pairings and settings stay in $CONFIG/ping and $CONFIG/pong"
    exit 0
fi

# A library the system lacks shows here, not as a program that will not
# start from the launcher.
missing=$(for program in ping-app pong; do
    ldd "$HERE/$program" | awk '/not found/ { print $1 }'
done | sort -u)
if [[ -n $missing ]]; then
    echo "These libraries are missing; install them with your package manager, then run this again:" >&2
    echo "$missing" | sed 's/^/  /' >&2
    # Ubuntu 24.04's names for them, which the programs were built against.
    packages=$(for lib in $missing; do
        case $lib in
            libavcodec.so.60) echo libavcodec60 ;;
            libavutil.so.58) echo libavutil58 ;;
            libswscale.so.7) echo libswscale7 ;;
            libxkbcommon.so.0) echo libxkbcommon0 ;;
            libxkbcommon-x11.so.0) echo libxkbcommon-x11-0 ;;
            libpipewire-0.3.so.0) echo libpipewire-0.3-0t64 ;;
            libpulse-simple.so.0) echo libpulse0 ;;
            libasound.so.2) echo libasound2t64 ;;
            libudev.so.1) echo libudev1 ;;
        esac
    done | sort -u | tr '\n' ' ')
    if [[ -n $packages ]] && command -v apt-get >/dev/null; then
        echo "On Ubuntu: sudo apt install $packages" >&2
    fi
    exit 1
fi

install -Dm755 "$HERE/ping-app" "$BIN/ping-app"
install -Dm755 "$HERE/pong" "$BIN/pong"

# The launcher entry and the unit name the programs by where they are now:
# a ~/.local/bin made just now is in the session's PATH only from the next
# login. Quoted, for a home folder with a space in it; a % doubled, which
# both read as the start of a specifier.
mkdir -p "$DATA/applications" "$UNITS"
while IFS= read -r line; do
    case $line in
        Exec=*) printf 'Exec="%s/ping-app"\n' "${BIN//%/%%}" ;;
        *) printf '%s\n' "$line" ;;
    esac
done < "$HERE/$ID.desktop" > "$DATA/applications/$ID.desktop"
install -Dm644 "$HERE/$ID.png" "$DATA/icons/hicolor/256x256/apps/$ID.png"
refresh_launcher
while IFS= read -r line; do
    case $line in
        ExecStart=*) printf 'ExecStart="%s/pong" host\n' "${BIN//%/%%}" ;;
        *) printf '%s\n' "$line" ;;
    esac
done < "$HERE/pong.service" > "$UNITS/pong.service"
echo "installed ping-app and pong in $BIN"

# The unit known to systemd, not enabled; a host that runs (hosting on)
# restarted on the new engine. Without a systemd user instance (some
# distributions, a session without one) the app works, but cannot host.
if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user try-restart pong.service
    if systemctl --user is-enabled --quiet pong.service 2>/dev/null; then
        echo "hosting is on: the host runs the new engine (systemctl --user status pong)"
    else
        echo "hosting is off: turn it on in Ping (Settings > Hosting)"
    fi
else
    echo "note: systemd's user instance did not answer: Ping works, but cannot host until it does"
fi

case ":$PATH:" in
    *":$BIN:"*) ;;
    *) echo "note: $BIN is not in PATH yet (it is after you log in again, on most desktops): until then, start Ping from the launcher" ;;
esac
