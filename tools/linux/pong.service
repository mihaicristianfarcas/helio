# The host, as a systemd user service in the desktop session it streams.
# Ping's install.sh (tools/linux/install-release) puts it in
# ~/.config/systemd/user with ExecStart naming the pong it installed beside
# the app, and does not enable it: hosting is off until the app's switch
# turns it on (`pong enable`: systemctl --user enable --now pong; off: pong
# disable).
#
# The desktop hands DISPLAY to user services (GNOME and KDE do). Logs:
# ~/.config/pong/logs, or `journalctl --user -u pong`.
[Unit]
Description=Pong, the pingpong streaming host
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/pong host
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
