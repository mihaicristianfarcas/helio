#!/usr/bin/env bash
# Install Helio from a checkout's build for this user, as the release does:
# the build laid out as tools/linux/package lays out the archive, then that
# layout's install.sh (tools/linux/install-release) run on it. So the app
# and the host's engine go to ~/.local/bin, the launcher entry and its icon
# to ~/.local/share, and the host's user unit to ~/.config/systemd/user,
# installed but not enabled.
#
#   cargo build --release -p helio-app && cargo build --release -p helio-host
#   tools/linux/install-apps                   # installs what was built
#   tools/linux/install-apps --uninstall       # hosting off first
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
TARGET=${CARGO_TARGET_DIR:-$REPO/target}/release

if [[ ${1:-} == --uninstall ]]; then
    exec "$REPO/tools/linux/install-release" --uninstall
fi
for program in helio-app helio-host; do
    if [[ ! -x $TARGET/$program ]]; then
        # Two builds: the host and the GPUI app ask one dependency for
        # different async runtimes (docs/development.md).
        echo "build it first: cargo build --release -p $program" >&2
        exit 1
    fi
done

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
cp "$TARGET/helio-app" "$TARGET/helio-host" "$STAGE/"
cp "$REPO/tools/linux/helio-host.service" "$REPO/tools/linux/dev.mihaicristian.helio.desktop" "$STAGE/"
cp "$REPO/helio-app/assets/icon-256.png" "$STAGE/dev.mihaicristian.helio.png"
cp "$REPO/tools/linux/install-release" "$STAGE/install.sh"
"$STAGE/install.sh"
