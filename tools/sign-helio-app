#!/usr/bin/env bash
# Sign Helio.app as tools/build-helio-app lays it out: the host's helper
# (Contents/Helpers/Helio Host.app), then the app around it. Inside out, as
# codesign requires of nested code (never --deep, which would sign the
# helper as the app and lose its own identifier).
#
#   tools/sign-helio-app [APP]    (default: target/Helio.app)
#
# With the Developer ID that HELIO_SIGN_IDENTITY names, with the hardened
# runtime and a secure timestamp, which notarization requires (a release;
# see tools/package-macos). Else with the dev identity when there is one (see
# tools/dev-signing-identity), so the permissions macOS grants the host
# survive a rebuild; else ad hoc. An app already signed is signed again.
set -euo pipefail
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
APP=${1:-$REPO/target/Helio.app}
HELPER="$APP/Contents/Helpers/Helio Host.app"

if [[ -n ${HELIO_SIGN_IDENTITY:-} ]]; then
    SIGN=(--sign "$HELIO_SIGN_IDENTITY" --options runtime --timestamp)
else
    DEV=$("$REPO/tools/dev-signing-identity" --check)
    SIGN=(--sign "${DEV:--}")
fi
codesign --force "${SIGN[@]}" --identifier dev.mihaicristian.helio.host "$HELPER" >/dev/null
codesign --force "${SIGN[@]}" --identifier dev.mihaicristian.helio "$APP" >/dev/null
# What Gatekeeper and an update check of the bundle: every nested signature
# whole, and sealed into the app's.
codesign --verify --deep --strict "$APP"
